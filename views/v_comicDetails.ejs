<%- include("header") %>
<%
    var basePath = '/comic/' + comic.savedFolder + '/' + comic.id;
    var encodePath = function (p) { return String(p || '').split('/').map(encodeURIComponent).join('/'); };
    var coverSrc = comic.coverImage ? '/public/uploads/' + encodeURIComponent(comic.savedFolder) + '/' + encodePath(comic.coverImage) : '';
    var pageCount = viewerType === 'image' ? comicPages.length : (comic.totalPages || 0);
    var flashText = (typeof msg != 'undefined' && msg) ? String(msg) : '';
    var flashIsSuccess = /success|added|moved|removed|saved/i.test(flashText) && !/unable|invalid|could not|must|only/i.test(flashText);
%>
<style>
:where(.cr-card) {
    background: var(--cr-surface, #1c1c1f);
    border: 1px solid var(--cr-border, #2e2e33);
    border-radius: var(--cr-radius, 14px);
    box-shadow: var(--cr-shadow, 0 8px 24px rgba(0, 0, 0, .35));
    padding: 1.5rem;
}
:where(.cr-page-title) { font-weight: 700; letter-spacing: -.01em; }
/* Bootstrap display utilities use !important; keep the hidden attribute authoritative */
.cd-page [hidden] { display: none !important; }
:where(.cr-empty-state) { text-align: center; padding: 2rem 1rem; color: var(--cr-muted, #a3a3ad); }

.cd-page { text-align: left; color: var(--cr-text, #f2f2f3); font-family: var(--cr-font, inherit); }
.cd-muted { color: var(--cr-muted, #a3a3ad); }
.cd-page .fw-semibold { font-weight: 600; }
.cd-page .min-w-0 { min-width: 0; }
.cd-section-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; }

/* Form controls tuned for the dark surface (Bootstrap 5.0 has no dark form theme) */
.cd-page .form-label { color: var(--cr-text, #f2f2f3); font-weight: 600; font-size: .9rem; margin-bottom: .35rem; }
.cd-page .form-control {
    background-color: var(--cr-surface-2, #242428);
    border: 1px solid var(--cr-border, #3a3a40);
    color: var(--cr-text, #f2f2f3);
    border-radius: var(--cr-radius-sm, 8px);
}
.cd-page .form-control::placeholder { color: var(--cr-muted, #8b8b95); opacity: 1; }
.cd-page .form-control:focus {
    background-color: var(--cr-surface-2, #242428);
    color: var(--cr-text, #f2f2f3);
    border-color: var(--cr-accent, #f0a530);
    box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--cr-accent, #f0a530) 30%, transparent);
}
.cd-page .form-control:disabled { opacity: .6; }
.cd-page .form-control::file-selector-button { background: var(--cr-surface, #1c1c1f); color: var(--cr-text, #f2f2f3); }
.cd-page .form-text { color: var(--cr-muted, #a3a3ad); }
.cd-page textarea.form-control { min-height: 180px; resize: vertical; }
.cd-page .is-ai-filled { animation: cd-flash 1.6s ease-out 1; }
@keyframes cd-flash {
    0% { box-shadow: 0 0 0 .25rem color-mix(in srgb, var(--cr-accent, #f0a530) 55%, transparent); }
    100% { box-shadow: 0 0 0 0 transparent; }
}

.cd-page .btn-accent {
    background: var(--cr-accent, #f0a530);
    border-color: var(--cr-accent, #f0a530);
    color: var(--cr-accent-contrast, #1a1205);
    font-weight: 600;
}
.cd-page .btn-accent:hover:not(:disabled) { filter: brightness(1.08); color: var(--cr-accent-contrast, #1a1205); }
.cd-page .btn:focus-visible, .cd-page a:focus-visible, .cd-modal .btn:focus-visible { outline: 3px solid var(--cr-accent, #f0a530); outline-offset: 2px; box-shadow: none; }

/* Cover preview */
.cd-cover {
    aspect-ratio: 2 / 3;
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    border-radius: var(--cr-radius-sm, 8px);
    background: var(--cr-bg, #111113);
    border: 1px solid var(--cr-border, #2e2e33);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.cd-cover img { width: 100%; height: 100%; object-fit: contain; }
.cd-cover-empty { color: var(--cr-muted, #a3a3ad); font-size: 2.5rem; }
.cd-meta { display: grid; grid-template-columns: auto 1fr; gap: .35rem 1rem; font-size: .875rem; margin: 1rem 0 0; }
.cd-meta dt { color: var(--cr-muted, #a3a3ad); font-weight: 400; }
.cd-meta dd { margin: 0; overflow-wrap: anywhere; }
@media (max-width: 991.98px) {
    /* Compact cover row on small screens so the form stays near the top */
    .cd-cover-wrap { display: flex; gap: 1rem; align-items: flex-start; }
    .cd-cover-wrap .cd-cover { width: 110px; flex-shrink: 0; margin: 0; }
    .cd-cover-wrap .cd-meta { margin-top: 0; flex: 1; min-width: 0; }
    .cd-cover-empty { font-size: 1.75rem; }
}

/* Page grid */
.cd-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; list-style: none; padding: 0; margin: 0; }
@media (max-width: 420px) { .cd-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; } }
.cd-tile {
    display: flex;
    flex-direction: column;
    background: var(--cr-surface-2, #242428);
    border: 1px solid var(--cr-border, #2e2e33);
    border-radius: var(--cr-radius-sm, 8px);
    overflow: hidden;
}
.cd-thumb { position: relative; aspect-ratio: 2 / 3; background: var(--cr-bg, #111113); }
.cd-thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
.cd-thumb-link:focus-visible { outline: 3px solid var(--cr-accent, #f0a530); outline-offset: -3px; }
.cd-page-num {
    position: absolute;
    top: .4rem;
    left: .4rem;
    min-width: 2rem;
    padding: .15rem .5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, .75);
    color: #fff;
    font-weight: 700;
    font-size: .8rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
}
.cd-tile-body { padding: .6rem; display: flex; flex-direction: column; gap: .5rem; }
.cd-file { font-size: .75rem; color: var(--cr-muted, #a3a3ad); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cd-tile-actions { display: flex; gap: .35rem; }
.cd-tile-actions form { flex: 1; display: flex; }
.cd-tile-actions .btn { flex: 1; padding: .25rem 0; }
.cd-move { display: flex; gap: .35rem; }
.cd-move .form-control { padding: .2rem .4rem; font-size: .85rem; min-width: 0; }

/* Toasts */
.cd-toasts { position: fixed; right: 1rem; bottom: 1rem; z-index: 1080; display: flex; flex-direction: column; gap: .5rem; max-width: min(380px, calc(100vw - 2rem)); }
.cd-toast {
    display: flex;
    align-items: flex-start;
    gap: .6rem;
    padding: .75rem .9rem;
    border-radius: var(--cr-radius-sm, 8px);
    background: var(--cr-surface, #1c1c1f);
    color: var(--cr-text, #f2f2f3);
    border: 1px solid var(--cr-border, #3a3a40);
    border-left: 4px solid var(--cr-accent, #f0a530);
    box-shadow: var(--cr-shadow, 0 8px 24px rgba(0, 0, 0, .45));
    text-align: left;
    animation: cd-toast-in .2s ease-out;
}
.cd-toast.is-success { border-left-color: var(--cr-success, #3fb950); }
.cd-toast.is-success .cd-toast-icon { color: var(--cr-success, #3fb950); }
.cd-toast.is-error { border-left-color: var(--cr-danger, #e5534b); }
.cd-toast.is-error .cd-toast-icon { color: var(--cr-danger, #e5534b); }
.cd-toast-icon { margin-top: .15rem; color: var(--cr-accent, #f0a530); }
.cd-toast-close { background: none; border: 0; color: var(--cr-muted, #a3a3ad); padding: 0 .25rem; margin-left: auto; line-height: 1; }
.cd-toast-close:hover { color: var(--cr-text, #f2f2f3); }
.cd-toast-close:focus-visible { outline: 2px solid var(--cr-accent, #f0a530); }
@keyframes cd-toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

/* Modal */
.cd-modal .modal-content { background: var(--cr-surface, #1c1c1f); color: var(--cr-text, #f2f2f3); border: 1px solid var(--cr-border, #3a3a40); border-radius: var(--cr-radius, 14px); text-align: left; }
.cd-modal .modal-header, .cd-modal .modal-footer { border-color: var(--cr-border, #3a3a40); }
.cd-modal .btn-close { filter: invert(1) grayscale(100%) brightness(200%); }
.cd-modal-thumb { width: 72px; aspect-ratio: 2 / 3; object-fit: contain; background: var(--cr-bg, #111113); border-radius: 6px; flex-shrink: 0; }

@media (prefers-reduced-motion: reduce) {
    .cd-toast, .cd-page .is-ai-filled { animation: none; }
}
</style>

<main class="container content_c mt-4 mb-5 cd-page" id="comicEditor"
      data-ai-url="<%= basePath %>/ai-metadata">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div class="min-w-0">
            <a href="/comic" class="small cd-muted text-decoration-none"><i class="fas fa-arrow-left" aria-hidden="true"></i> Gallery</a>
            <h1 class="cr-page-title h3 mb-0 mt-1">Edit comic</h1>
            <div class="cd-muted text-truncate"><%= comic.title || 'Untitled comic' %></div>
        </div>
        <a class="btn btn-outline-light" href="/comic/show/<%= comic.id %>"><i class="fas fa-book-open" aria-hidden="true"></i> Open comic</a>
    </div>

    <div class="row g-4">
        <!-- Details form -->
        <div class="col-12 col-lg-8 order-2 order-lg-1">
            <section class="cr-card h-100" aria-labelledby="detailsHeading">
                <h2 id="detailsHeading" class="cd-section-title">Details</h2>
                <form method="post" id="detailsForm" data-busy-text="Saving...">
                    <div class="mb-3">
                        <label class="form-label" for="titleText">Title <span class="cd-muted fw-normal">(required)</span></label>
                        <input class="form-control" type="text" name="title" id="titleText" placeholder="e.g. The Amazing Adventures" value="<%= comic.title || '' %>" required autocomplete="off">
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="authortext">Author</label>
                        <input class="form-control" type="text" name="author" id="authortext" placeholder="Writer or artist" value="<%= comic.author || '' %>" autocomplete="off">
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-end">
                            <label class="form-label" for="descriptionText">Description</label>
                            <span id="descriptionCount" class="small cd-muted mb-1"></span>
                        </div>
                        <textarea name="description" class="form-control" id="descriptionText" maxlength="5000" placeholder="A short summary readers will see in the gallery" aria-describedby="descriptionHelp"><%= comic.description || '' %></textarea>
                        <div id="descriptionHelp" class="form-text">Up to 5,000 characters.</div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <button type="button" id="aiFillButton" class="btn btn-outline-info btn-sm" aria-describedby="aiFillStatus">
                            <span class="cd-btn-icon"><i class="fas fa-robot" aria-hidden="true"></i></span>
                            <span class="cd-btn-label">AI fill title, author &amp; description</span>
                        </button>
                        <div id="aiFillStatus" class="form-text text-info m-0" role="status" aria-live="polite"></div>
                    </div>
                    <p class="form-text mb-0 mt-1">AI reads the first pages and fills the fields above. Nothing is saved until you press Save.</p>

                    <button class="btn btn-accent w-100 mt-4" type="submit" name="submit" value="Save Details">
                        <i class="fas fa-save" aria-hidden="true"></i> <span class="cd-btn-label">Save details</span>
                    </button>
                </form>
            </section>
        </div>

        <!-- Cover preview -->
        <div class="col-12 col-lg-4 order-1 order-lg-2">
            <aside class="cr-card h-100" aria-labelledby="coverHeading">
                <h2 id="coverHeading" class="cd-section-title">Cover</h2>
                <div class="cd-cover-wrap">
                <div class="cd-cover">
                    <% if (coverSrc) { %>
                        <img src="<%= coverSrc %>" alt="Cover of <%= comic.title || 'this comic' %>" decoding="async" onerror="this.replaceWith(Object.assign(document.createElement('i'),{className:'fas fa-image cd-cover-empty'}))">
                    <% } else { %>
                        <i class="fas fa-image cd-cover-empty" aria-hidden="true"></i>
                        <span class="visually-hidden">No cover image</span>
                    <% } %>
                </div>
                <dl class="cd-meta">
                    <dt>Pages</dt><dd><%= pageCount %></dd>
                    <dt>Format</dt><dd><%= viewerType === 'pdf' ? 'PDF' : (viewerType === 'image' ? 'Images' : 'Unknown') %></dd>
                    <dt>Folder</dt><dd class="small"><%= comic.savedFolder %></dd>
                </dl>
                </div>
                <% if (viewerType === 'image') { %>
                <p class="form-text mb-0 mt-3">The first page is used as the cover. Move a page to position 1 to change it.</p>
                <% } %>
            </aside>
        </div>
    </div>

    <!-- Page management -->
    <section class="cr-card mt-4" aria-labelledby="pagesHeading">
        <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h2 id="pagesHeading" class="cd-section-title mb-0">Pages</h2>
            <% if (viewerType === 'image') { %><span class="small cd-muted"><%= comicPages.length %> page<%= comicPages.length === 1 ? '' : 's' %></span><% } %>
        </div>

        <% if (viewerType !== 'image') { %>
            <div class="cr-empty-state">
                <i class="fas fa-file-pdf fa-2x mb-2" aria-hidden="true"></i>
                <p class="mb-0">Page management is available only for image-based comics. PDF uploads can still be edited for title, author and description.</p>
            </div>
        <% } else { %>
            <form method="post" action="<%= basePath %>/pages/add" enctype="multipart/form-data" class="row g-3 align-items-end mt-1 mb-4" id="addPagesForm" data-busy-text="Uploading...">
                <div class="col-12 col-md-7">
                    <label class="form-label" for="pageFilesInput">Add new pages</label>
                    <input class="form-control" type="file" id="pageFilesInput" name="pageFiles" accept=".jpg,.jpeg,.png,.webp,.gif,.svg,.avif,.apng" multiple required aria-describedby="pageFilesHelp">
                    <div id="pageFilesHelp" class="form-text">JPG, PNG, WebP, GIF, SVG or AVIF. You can select several files.</div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="insertAfterInput">Insert after page</label>
                    <input class="form-control" type="number" id="insertAfterInput" name="insertAfter" min="0" max="<%= comicPages.length %>" value="<%= comicPages.length %>" aria-describedby="insertAfterHelp">
                    <div id="insertAfterHelp" class="form-text">0 = at the start</div>
                </div>
                <div class="col-6 col-md-2 d-grid">
                    <button class="btn btn-accent" type="submit"><i class="fas fa-plus" aria-hidden="true"></i> <span class="cd-btn-label">Add</span></button>
                    <div class="form-text">&nbsp;</div>
                </div>
            </form>

            <ol class="cd-grid" aria-label="Comic pages">
                <% comicPages.forEach((page) => { var pageSrc = '/public/uploads/' + encodeURIComponent(comic.savedFolder) + '/' + encodePath(page.relativePath); %>
                <li class="cd-tile">
                    <div class="cd-thumb">
                        <a class="cd-thumb-link d-block w-100 h-100" href="<%= pageSrc %>" target="_blank" rel="noopener" aria-label="View page <%= page.number %> full size (opens in a new tab)">
                            <img src="<%= pageSrc %>" loading="lazy" decoding="async" fetchpriority="low" alt="Page <%= page.number %>" width="200" height="300">
                        </a>
                        <span class="cd-page-num" aria-hidden="true"><%= page.number %></span>
                    </div>
                    <div class="cd-tile-body">
                        <div class="cd-file" title="<%= page.relativePath %>"><span class="visually-hidden">Page <%= page.number %>, file </span><%= page.fileName || page.relativePath %></div>
                        <div class="cd-tile-actions">
                            <form method="post" action="<%= basePath %>/pages/move" data-busy-text="">
                                <input type="hidden" name="pageNumber" value="<%= page.number %>">
                                <input type="hidden" name="targetPageNumber" value="<%= page.number - 1 %>">
                                <button class="btn btn-sm btn-outline-light" type="submit" title="Move earlier" aria-label="Move page <%= page.number %> earlier" <%= page.number <= 1 ? 'disabled' : '' %>><i class="fas fa-chevron-left" aria-hidden="true"></i></button>
                            </form>
                            <form method="post" action="<%= basePath %>/pages/move" data-busy-text="">
                                <input type="hidden" name="pageNumber" value="<%= page.number %>">
                                <input type="hidden" name="targetPageNumber" value="<%= page.number + 1 %>">
                                <button class="btn btn-sm btn-outline-light" type="submit" title="Move later" aria-label="Move page <%= page.number %> later" <%= page.number >= comicPages.length ? 'disabled' : '' %>><i class="fas fa-chevron-right" aria-hidden="true"></i></button>
                            </form>
                            <form method="post" action="<%= basePath %>/pages/delete" class="js-delete-page" data-page-number="<%= page.number %>" data-page-src="<%= pageSrc %>" data-busy-text="">
                                <input type="hidden" name="pageNumber" value="<%= page.number %>">
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="<%= comicPages.length <= 1 ? 'A comic needs at least one page' : 'Remove page' %>" aria-label="Remove page <%= page.number %>" <%= comicPages.length <= 1 ? 'disabled' : '' %>><i class="fas fa-trash-alt" aria-hidden="true"></i></button>
                            </form>
                        </div>
                        <form method="post" action="<%= basePath %>/pages/move" class="cd-move" data-busy-text="">
                            <input type="hidden" name="pageNumber" value="<%= page.number %>">
                            <label class="visually-hidden" for="movePage<%= page.number %>">Move page <%= page.number %> to position</label>
                            <input class="form-control form-control-sm" id="movePage<%= page.number %>" type="number" name="targetPageNumber" min="1" max="<%= comicPages.length %>" value="<%= page.number %>" inputmode="numeric">
                            <button class="btn btn-sm btn-outline-light" type="submit">Move</button>
                        </form>
                    </div>
                </li>
                <% }) %>
            </ol>
            <% if (comicPages.length === 0) { %>
                <div class="cr-empty-state"><p class="mb-0">This comic has no pages yet. Add images above.</p></div>
            <% } %>
        <% } %>
    </section>
</main>

<!-- Delete confirmation -->
<div class="modal fade cd-modal" id="deletePageModal" tabindex="-1" aria-labelledby="deletePageTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="deletePageTitle">Remove page?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body d-flex gap-3 align-items-center">
                <img id="deletePageThumb" class="cd-modal-thumb" alt="" decoding="async">
                <p class="mb-0">Page <strong id="deletePageNumber"></strong> will be deleted from this comic. The remaining pages are renumbered. This cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton"><i class="fas fa-trash-alt" aria-hidden="true"></i> Remove page</button>
            </div>
        </div>
    </div>
</div>

<!-- Toasts: success/info are polite, errors are assertive -->
<div class="cd-toasts" id="toastRegion" role="status" aria-live="polite" aria-atomic="false">
    <% if (flashText) { %>
    <div class="cd-toast <%= flashIsSuccess ? 'is-success' : 'is-error' %>" data-autohide="<%= flashIsSuccess ? '1' : '0' %>">
        <i class="fas <%= flashIsSuccess ? 'fa-check-circle' : 'fa-exclamation-circle' %> cd-toast-icon" aria-hidden="true"></i>
        <div><%= flashText %></div>
        <button type="button" class="cd-toast-close" aria-label="Dismiss message">&times;</button>
    </div>
    <% } %>
</div>

<script>
(function () {
    var editor = document.getElementById('comicEditor');
    var toastRegion = document.getElementById('toastRegion');
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- toasts ----------
    function wireToast(toast) {
        var close = toast.querySelector('.cd-toast-close');
        var remove = function () { if (toast.parentNode) toast.parentNode.removeChild(toast); };
        if (close) close.addEventListener('click', remove);
        if (toast.getAttribute('data-autohide') === '1') setTimeout(remove, 6000);
    }

    function showToast(message, type) {
        var toast = document.createElement('div');
        toast.className = 'cd-toast' + (type === 'success' ? ' is-success' : type === 'error' ? ' is-error' : '');
        toast.setAttribute('data-autohide', type === 'error' ? '0' : '1');
        if (type === 'error') toast.setAttribute('role', 'alert');
        var icon = document.createElement('i');
        icon.className = 'fas cd-toast-icon ' + (type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle');
        icon.setAttribute('aria-hidden', 'true');
        var text = document.createElement('div');
        text.textContent = message;
        var close = document.createElement('button');
        close.type = 'button';
        close.className = 'cd-toast-close';
        close.setAttribute('aria-label', 'Dismiss message');
        close.innerHTML = '&times;';
        toast.appendChild(icon);
        toast.appendChild(text);
        toast.appendChild(close);
        toastRegion.appendChild(toast);
        wireToast(toast);
    }

    Array.prototype.forEach.call(toastRegion.querySelectorAll('.cd-toast'), wireToast);

    // ---------- busy state for form submissions ----------
    var SPINNER = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';

    function setButtonBusy(button, busyText) {
        if (!button || button.dataset.busy === '1') return;
        button.dataset.busy = '1';
        button.dataset.originalHtml = button.innerHTML;
        button.disabled = true;
        button.setAttribute('aria-busy', 'true');
        button.innerHTML = SPINNER + (busyText ? ' <span>' + busyText + '</span>' : '<span class="visually-hidden">Working...</span>');
    }

    function resetButton(button) {
        if (!button || button.dataset.busy !== '1') return;
        button.innerHTML = button.dataset.originalHtml;
        button.disabled = false;
        button.removeAttribute('aria-busy');
        delete button.dataset.busy;
    }

    function lockForms() {
        // Prevent a second request while one is on its way
        Array.prototype.forEach.call(editor.querySelectorAll('form button[type="submit"]'), function (b) {
            if (b.dataset.busy !== '1' && !b.disabled) {
                b.disabled = true;
                b.dataset.locked = '1';
            }
        });
    }

    var submitting = false;
    function markSubmitting(form, submitter) {
        submitting = true;
        isDirty = false;
        var button = submitter || form.querySelector('button[type="submit"]');
        // Defer so the submitter's name/value is still part of the request
        setTimeout(function () {
            setButtonBusy(button, form.getAttribute('data-busy-text') || '');
            lockForms();
        }, 0);
    }

    Array.prototype.forEach.call(editor.querySelectorAll('form'), function (form) {
        form.addEventListener('submit', function (event) {
            if (submitting) {
                event.preventDefault();
                return;
            }
            if (form.classList.contains('js-delete-page')) {
                event.preventDefault();
                askDelete(form);
                return;
            }
            if (form.id === 'addPagesForm' && !validatePageFiles()) {
                event.preventDefault();
                return;
            }
            markSubmitting(form, event.submitter);
        });
    });

    // Restore buttons when the page comes back from the back/forward cache
    window.addEventListener('pageshow', function (event) {
        if (!event.persisted) return;
        submitting = false;
        Array.prototype.forEach.call(editor.querySelectorAll('button[data-busy="1"]'), resetButton);
        Array.prototype.forEach.call(editor.querySelectorAll('button[data-locked="1"]'), function (b) {
            b.disabled = false;
            delete b.dataset.locked;
        });
    });

    // ---------- add pages validation ----------
    var pageFilesInput = document.getElementById('pageFilesInput');
    var IMAGE_RE = /\.(?:apng|avif|gif|jpeg|png|svg|webp|jpg)$/i;
    function validatePageFiles() {
        if (!pageFilesInput) return true;
        var files = Array.prototype.slice.call(pageFilesInput.files || []);
        if (files.length === 0) {
            showToast('Choose at least one image to add.', 'error');
            pageFilesInput.focus();
            return false;
        }
        var bad = files.filter(function (f) { return !IMAGE_RE.test(f.name); });
        if (bad.length) {
            showToast('Only image files can be added as pages: ' + bad.map(function (f) { return f.name; }).join(', '), 'error');
            pageFilesInput.focus();
            return false;
        }
        return true;
    }
    if (pageFilesInput) {
        pageFilesInput.addEventListener('change', function () {
            var help = document.getElementById('pageFilesHelp');
            var count = pageFilesInput.files ? pageFilesInput.files.length : 0;
            help.textContent = count ? count + ' file' + (count === 1 ? '' : 's') + ' selected.' : 'JPG, PNG, WebP, GIF, SVG or AVIF. You can select several files.';
        });
    }

    // ---------- delete confirmation ----------
    var modalEl = document.getElementById('deletePageModal');
    var confirmButton = document.getElementById('confirmDeleteButton');
    var pendingDeleteForm = null;
    var modal = (window.bootstrap && bootstrap.Modal) ? new bootstrap.Modal(modalEl) : null;

    function askDelete(form) {
        var number = form.getAttribute('data-page-number');
        if (!modal) {
            if (window.confirm('Remove page ' + number + '? This cannot be undone.')) submitDelete(form);
            return;
        }
        pendingDeleteForm = form;
        document.getElementById('deletePageNumber').textContent = number;
        document.getElementById('deletePageThumb').src = form.getAttribute('data-page-src') || '';
        modal.show();
    }

    function submitDelete(form) {
        markSubmitting(form, form.querySelector('button[type="submit"]'));
        form.submit(); // submit() skips the submit event, so no second confirmation
    }

    if (modalEl) {
        modalEl.addEventListener('shown.bs.modal', function () { confirmButton.focus(); });
        modalEl.addEventListener('hidden.bs.modal', function () {
            if (pendingDeleteForm && !submitting) {
                var trigger = pendingDeleteForm.querySelector('button[type="submit"]');
                if (trigger) trigger.focus();
            }
            pendingDeleteForm = null;
        });
    }
    confirmButton.addEventListener('click', function () {
        if (!pendingDeleteForm) return;
        var form = pendingDeleteForm;
        setButtonBusy(confirmButton, 'Removing...');
        submitDelete(form);
    });

    // ---------- description counter ----------
    var descriptionInput = document.getElementById('descriptionText');
    var descriptionCount = document.getElementById('descriptionCount');
    function updateCount() {
        if (!descriptionInput || !descriptionCount) return;
        descriptionCount.textContent = descriptionInput.value.length.toLocaleString() + ' / 5,000';
    }
    if (descriptionInput) descriptionInput.addEventListener('input', updateCount);
    updateCount();

    // ---------- unsaved changes warning for the details form ----------
    var detailsForm = document.getElementById('detailsForm');
    var isDirty = false;
    if (detailsForm) {
        detailsForm.addEventListener('input', function () { isDirty = true; });
    }
    window.addEventListener('beforeunload', function (event) {
        if (!isDirty || submitting) return undefined;
        event.preventDefault();
        event.returnValue = 'You have unsaved changes to the comic details.';
        return event.returnValue;
    });

    // ---------- AI fill ----------
    var aiButton = document.getElementById('aiFillButton');
    var aiStatus = document.getElementById('aiFillStatus');
    var titleInput = document.querySelector('input[name="title"]');
    var authorInput = document.getElementById('authortext');
    if (!aiButton || !aiStatus || !titleInput || !authorInput) {
        return;
    }

    function flashField(input) {
        if (reduceMotion) return;
        input.classList.remove('is-ai-filled');
        void input.offsetWidth; // restart animation
        input.classList.add('is-ai-filled');
    }

    aiButton.addEventListener('click', function () {
        setButtonBusy(aiButton, 'Reading pages...');
        aiStatus.className = 'form-text text-info m-0';
        aiStatus.textContent = 'Reading the first pages...';
        fetch(editor.getAttribute('data-ai-url'), { method: 'POST', headers: { 'Accept': 'application/json' } })
            .then(function (response) {
                return response.json().catch(function () {
                    return { error: response.status === 401 || response.redirected ? 'Your session has expired. Reload the page and log in again.' : 'The server sent an unexpected response.' };
                }).then(function (data) {
                    return { ok: response.ok && !(data && data.error), data: data || {} };
                });
            })
            .then(function (result) {
                if (!result.ok) {
                    throw new Error(result.data && result.data.error ? result.data.error : 'AI request failed.');
                }
                var filledFields = [];
                if (result.data.title) {
                    titleInput.value = result.data.title;
                    filledFields.push('title');
                    flashField(titleInput);
                }
                if (typeof result.data.author === 'string' && result.data.author !== '') {
                    authorInput.value = result.data.author;
                    filledFields.push('author');
                    flashField(authorInput);
                }
                if (descriptionInput && typeof result.data.description === 'string' && result.data.description !== '') {
                    descriptionInput.value = result.data.description;
                    filledFields.push('description');
                    flashField(descriptionInput);
                    updateCount();
                }
                var skippedFields = ['title', 'author', 'description'].filter(function (field) {
                    return filledFields.indexOf(field) === -1 && (field !== 'description' || descriptionInput);
                });
                function listWords(words) {
                    if (words.length <= 1) return words.join('');
                    return words.slice(0, -1).join(', ') + ' and ' + words[words.length - 1];
                }
                if (filledFields.length) {
                    isDirty = true;
                    var note = 'Filled the ' + listWords(filledFields) + '.';
                    if (skippedFields.length) {
                        note += ' No ' + listWords(skippedFields) + ' visible on the first pages, so ' + (skippedFields.length > 1 ? 'they were' : 'it was') + ' left unchanged.';
                    }
                    aiStatus.className = 'form-text text-success m-0';
                    aiStatus.textContent = note + ' Review and save.';
                    showToast(note + ' Review the text, then save.', 'success');
                } else {
                    aiStatus.className = 'form-text text-warning m-0';
                    aiStatus.textContent = 'No title, author or description is visible on the first pages. Your fields were left unchanged.';
                }
            })
            .catch(function (error) {
                aiStatus.className = 'form-text text-danger m-0';
                aiStatus.textContent = error.message;
                showToast(error.message, 'error');
            })
            .finally(function () {
                resetButton(aiButton);
            });
    });
})();
</script>
<%- include("footer") %>
