<%-include("header")%>
<%
    var jobStatus = job.status || 'pending';
    var jobProgress = Number(job.progress) || 0;
    if (jobStatus === 'completed') { jobProgress = 100; }
    // Stage mapping mirrors utils/jobProcessor.js: pending -> processing (10..84 extracting, 85..99 finishing) -> completed/failed.
    // Steps are rendered by the inline script below.
    var stageTitles = {
        pending: 'Waiting in the queue',
        processing: jobProgress >= 85 ? 'Reading details and saving' : 'Extracting pages',
        completed: 'Your comic is ready',
        failed: 'Processing failed'
    };
    var hasComicLinks = jobStatus === 'completed' && job.comicId && job.comicFolderId;
%>
<style>
:where(.cr-card) {
    background: var(--cr-surface, #1c1c1f);
    border: 1px solid var(--cr-border, #2e2e33);
    border-radius: var(--cr-radius, 14px);
    box-shadow: var(--cr-shadow, 0 8px 24px rgba(0, 0, 0, .35));
    padding: 1.75rem;
}
:where(.cr-page-title) { font-weight: 700; letter-spacing: -.01em; }
/* Bootstrap display utilities use !important; keep the hidden attribute authoritative */
.st-page [hidden] { display: none !important; }

.st-page { max-width: 680px; text-align: left; color: var(--cr-text, #f2f2f3); font-family: var(--cr-font, inherit); }
.st-muted { color: var(--cr-muted, #a3a3ad); }
.st-file { word-break: break-all; }

.st-steps { list-style: none; display: flex; padding: 0; margin: 1.75rem 0 1.5rem; }
.st-step { flex: 1; position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; font-size: .85rem; color: var(--cr-muted, #a6a6b0); }
.st-step::before {
    /* connector line */
    content: "";
    position: absolute;
    top: 15px;
    left: -50%;
    width: 100%;
    height: 2px;
    background: var(--cr-border, #3a3a40);
    z-index: 0;
}
.st-step:first-child::before { display: none; }
.st-dot {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 2px solid var(--cr-border, #3a3a40);
    background: var(--cr-surface, #1b1b1f);
    font-size: .8rem;
    font-weight: 700;
    margin-bottom: .4rem;
}
.st-step.is-done { color: var(--cr-text, #ededf0); }
.st-step.is-done .st-dot { background: var(--cr-success, #4ade80); border-color: var(--cr-success, #4ade80); color: #0d1f10; }
.st-step.is-done::before, .st-step.is-active::before { background: var(--cr-success, #4ade80); }
.st-step.is-active { color: var(--cr-text, #ededf0); font-weight: 600; }
.st-step.is-active .st-dot { border-color: var(--cr-accent, #f5a524); color: var(--cr-accent, #f5a524); box-shadow: 0 0 0 4px color-mix(in srgb, var(--cr-accent, #f5a524) 25%, transparent); }
.st-step.is-failed { color: var(--cr-danger, #f87171); font-weight: 600; }
.st-step.is-failed .st-dot { background: var(--cr-danger, #f87171); border-color: var(--cr-danger, #f87171); color: #fff; }

.st-progress { height: 14px; background: var(--cr-surface-2, #2a2a2f); border-radius: 999px; }
.st-progress .progress-bar { background-color: var(--cr-accent, #f5a524); transition: width .4s ease; }
.st-progress .progress-bar.is-done { background-color: var(--cr-success, #4ade80); }
.st-progress .progress-bar.is-failed { background-color: var(--cr-danger, #f87171); }

.st-headline { display: flex; align-items: center; gap: .75rem; }
.st-headline-icon { font-size: 1.6rem; color: var(--cr-accent, #f5a524); }
.st-headline-icon.is-done { color: var(--cr-success, #4ade80); }
.st-headline-icon.is-failed { color: var(--cr-danger, #f87171); }
.st-spin { animation: st-spin 1.1s linear infinite; }
@keyframes st-spin { to { transform: rotate(360deg); } }

.st-page .btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border-radius: var(--cr-radius-sm, 8px); }
.st-page .btn-accent {
    background: var(--cr-accent, #f5a524);
    border-color: var(--cr-accent, #f5a524);
    color: var(--cr-accent-contrast, #1a1204);
    font-weight: 600;
}
.st-page .btn-accent:hover { filter: brightness(1.08); color: var(--cr-accent-contrast, #1a1204); }
.st-page .btn-quiet { background: var(--cr-surface-2, #26262b); border: 1px solid var(--cr-border, #34343b); color: var(--cr-text, #ededf0); font-weight: 600; }
.st-page .btn-quiet:hover { border-color: var(--cr-muted, #a6a6b0); color: var(--cr-text, #ededf0); }
.st-page .btn:focus-visible, .st-page a:focus-visible { outline: 3px solid var(--cr-accent, #f5a524); outline-offset: 2px; box-shadow: none; }
.st-page .fw-semibold { font-weight: 600; }
.st-meta { font-size: .8rem; }
.st-page .btn-link { color: var(--cr-accent, #f5a524); min-height: 44px; }
.st-page .min-w-0 { min-width: 0; }
.st-nav { display: flex; flex-wrap: wrap; gap: .5rem; }
.st-nav a { min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; padding: 0 .25rem; color: var(--cr-muted, #a6a6b0); text-decoration: none; font-weight: 600; font-size: .9rem; }
.st-nav a:hover { color: var(--cr-text, #ededf0); }

/* Phones: compact vertical stepper, full-width result actions */
@media (max-width: 575.98px) {
    .st-page .cr-card { padding: 1.1rem; }
    .st-headline-icon { font-size: 1.4rem; }
    .st-steps { flex-direction: column; margin: 1.25rem 0 1.25rem; gap: .65rem; }
    .st-step { flex-direction: row; text-align: left; gap: .75rem; font-size: .95rem; }
    .st-step::before { top: -.65rem; left: 13px; width: 2px; height: calc(.65rem + 4px); }
    .st-dot { width: 28px; height: 28px; margin: 0; font-size: .75rem; }
    .st-step.is-active .st-dot { box-shadow: 0 0 0 3px color-mix(in srgb, var(--cr-accent, #f5a524) 25%, transparent); }
    .st-actions { flex-direction: column; }
    .st-actions .btn { width: 100%; min-height: 50px; font-size: 1.05rem; }
    .st-footer { flex-direction: column; align-items: stretch !important; }
    .st-footer .st-meta { text-align: left !important; }
}
@media (prefers-reduced-motion: reduce) {
    .st-spin { animation: none; }
    .st-progress .progress-bar { transition: none; }
}
</style>

<div class="container content_c mt-4 mb-5 st-page">
    <div class="cr-card status-container"
         data-job-id="<%=job.jobId%>"
         data-current-status="<%=jobStatus%>"
         data-current-progress="<%=jobProgress%>"
         data-comic-id="<%=job.comicId || ''%>"
         data-comic-folder-id="<%=job.comicFolderId || ''%>">

        <% if(typeof msg != 'undefined' && msg != ""){ %>
        <div class="alert alert-info mb-3" role="status"><%=msg%></div>
        <% } %>

        <div class="st-headline">
            <i id="headlineIcon" aria-hidden="true" class="fas <%= jobStatus === 'completed' ? 'fa-check-circle is-done' : (jobStatus === 'failed' ? 'fa-times-circle is-failed' : 'fa-spinner st-spin') %> st-headline-icon"></i>
            <div class="min-w-0">
                <h1 class="cr-page-title h4 mb-0" id="statusText"><%= stageTitles[jobStatus] || 'Processing your comic' %></h1>
                <div class="st-muted st-file small" id="fileName"><span class="visually-hidden">File: </span><%=job.fileName%></div>
            </div>
        </div>

        <ol class="st-steps" id="stageList" aria-label="Processing steps">
            <li class="st-step" data-stage="queued"><span class="st-dot" aria-hidden="true">1</span><span class="st-label">Queued<span class="visually-hidden st-step-state"></span></span></li>
            <li class="st-step" data-stage="extracting"><span class="st-dot" aria-hidden="true">2</span><span class="st-label">Extracting<span class="visually-hidden st-step-state"></span></span></li>
            <li class="st-step" data-stage="processing"><span class="st-dot" aria-hidden="true">3</span><span class="st-label">Processing<span class="visually-hidden st-step-state"></span></span></li>
            <li class="st-step" data-stage="done"><span class="st-dot" aria-hidden="true">4</span><span class="st-label">Done<span class="visually-hidden st-step-state"></span></span></li>
        </ol>

        <div class="d-flex justify-content-between align-items-baseline mb-2">
            <span class="fw-semibold" id="progressLabel">Progress</span>
            <span class="fw-bold" id="progressText" aria-hidden="true"><%= jobProgress %>%</span>
        </div>
        <div class="progress st-progress" id="progressWrap" role="progressbar" aria-labelledby="progressLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= jobProgress %>">
            <div id="progressBar" class="progress-bar <%= jobStatus === 'completed' ? 'is-done' : (jobStatus === 'failed' ? 'is-failed' : '') %>" style="width: <%= jobProgress %>%;"></div>
        </div>

        <!-- Announced to screen readers when the stage changes -->
        <p id="liveStatus" class="visually-hidden" role="status" aria-live="polite"></p>

        <div id="errorBox" class="alert alert-danger mt-4 mb-0" role="alert" <%= jobStatus === 'failed' ? '' : 'hidden' %>>
            <div class="fw-semibold"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i> We could not process this file.</div>
            <div id="errorMessage" class="small mt-1"><%= job.errorMessage || 'The file may be damaged or in an unsupported format.' %></div>
            <div class="small mt-2">Check that the file opens on your computer, then try uploading it again.</div>
        </div>

        <div id="connectionNotice" class="alert alert-warning mt-4 mb-0 small" role="status" hidden></div>

        <div id="doneActions" class="d-flex flex-wrap gap-2 mt-4 st-actions" <%= hasComicLinks ? '' : 'hidden' %>>
            <a id="btnOpenComic" class="btn btn-accent btn-lg px-4" href="<%= hasComicLinks ? '/comic/show/' + job.comicId : '#' %>">
                <i class="fas fa-book-open" aria-hidden="true"></i> Open comic
            </a>
            <a id="btnRedirect" class="btn btn-quiet btn-lg" href="<%= hasComicLinks ? '/comic/' + job.comicFolderId + '/' + job.comicId : '#' %>">
                <i class="fas fa-pen" aria-hidden="true"></i> Edit details
            </a>
        </div>

        <div id="redirectInfo" class="small st-muted mt-3" hidden>
            Opening the edit page in <span id="countdown">5</span>s.
            <button type="button" id="stayButton" class="btn btn-link btn-sm p-0 align-baseline">Stay on this page</button>
        </div>

        <div id="failedActions" class="d-flex flex-wrap gap-2 mt-4 st-actions" <%= jobStatus === 'failed' ? '' : 'hidden' %>>
            <a class="btn btn-accent btn-lg" href="/comic/upload"><i class="fas fa-redo" aria-hidden="true"></i> Upload another file</a>
        </div>

        <hr class="my-4" style="border-color: var(--cr-border, #34343b);">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 st-footer">
            <nav class="st-nav" aria-label="More">
                <a href="/comic/uploads"><i class="fas fa-list-ul" aria-hidden="true"></i> Your uploads</a>
                <a href="/comic"><i class="fas fa-th-large" aria-hidden="true"></i> Gallery</a>
            </nav>
            <div class="st-meta st-muted text-end">
                <div id="pollStatus"><%= (jobStatus === 'completed' || jobStatus === 'failed') ? 'Finished' : 'Checking for updates automatically' %></div>
                <div id="lastUpdate" hidden>Last checked: <span id="timestamp">--</span></div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var statusContainer = document.querySelector('.status-container');
    var jobId = statusContainer.dataset.jobId;
    var currentStatus = statusContainer.dataset.currentStatus;
    var lastProgress = Number(statusContainer.dataset.currentProgress) || 0;
    var sawActiveState = currentStatus === 'pending' || currentStatus === 'processing';

    var MIN_DELAY = 1500;
    var MAX_DELAY = 10000;
    var MAX_ERROR_DELAY = 30000;
    var delay = MIN_DELAY;
    var errorCount = 0;
    var pollTimer = null;
    var inFlight = false;
    var finished = false;
    var countdownTimer = null;
    var lastAnnounced = '';
    var quiet = true; // no announcement for the initial render

    var stageOrder = ['queued', 'extracting', 'processing', 'done'];
    var stageNames = { queued: 'Queued', extracting: 'Extracting', processing: 'Processing', done: 'Done' };

    function el(id) { return document.getElementById(id); }

    function stageFor(status, progress) {
        if (status === 'completed') return 'done';
        if (status === 'failed') {
            // Highlight the step that was running when it failed
            if (progress >= 85) return 'processing';
            return progress >= 10 ? 'extracting' : 'queued';
        }
        if (status === 'processing') return progress >= 85 ? 'processing' : 'extracting';
        return 'queued';
    }

    function titleFor(status, progress) {
        switch (status) {
            case 'pending': return 'Waiting in the queue';
            case 'processing': return progress >= 85 ? 'Reading details and saving' : 'Extracting pages';
            case 'completed': return 'Your comic is ready';
            case 'failed': return 'Processing failed';
            default: return 'Processing your comic';
        }
    }

    function announce(text) {
        if (quiet) {
            lastAnnounced = text;
            return;
        }
        if (text && text !== lastAnnounced) {
            lastAnnounced = text;
            el('liveStatus').textContent = text;
        }
    }

    function render(status, progress, errorMessage) {
        progress = status === 'completed' ? 100 : Math.max(0, Math.min(100, Number(progress) || 0));
        var stage = stageFor(status, progress);
        var activeIndex = stageOrder.indexOf(stage);

        Array.prototype.forEach.call(document.querySelectorAll('#stageList .st-step'), function (item, index) {
            var state = '';
            item.classList.remove('is-done', 'is-active', 'is-failed');
            item.removeAttribute('aria-current');
            if (status === 'failed' && index === activeIndex) {
                item.classList.add('is-failed');
                state = ' (failed)';
            } else if (index < activeIndex || (status === 'completed' && index === activeIndex)) {
                item.classList.add('is-done');
                state = ' (complete)';
            } else if (index === activeIndex) {
                item.classList.add('is-active');
                item.setAttribute('aria-current', 'step');
                state = ' (in progress)';
            }
            item.querySelector('.st-step-state').textContent = state;
        });

        var bar = el('progressBar');
        bar.style.width = progress + '%';
        bar.classList.toggle('is-done', status === 'completed');
        bar.classList.toggle('is-failed', status === 'failed');
        el('progressText').textContent = progress + '%';
        el('progressWrap').setAttribute('aria-valuenow', String(progress));

        var icon = el('headlineIcon');
        if (status === 'completed') icon.className = 'fas fa-check-circle st-headline-icon is-done';
        else if (status === 'failed') icon.className = 'fas fa-times-circle st-headline-icon is-failed';
        else icon.className = 'fas fa-spinner st-spin st-headline-icon';

        var title = titleFor(status, progress);
        el('statusText').textContent = title;

        if (status === 'failed') {
            el('errorBox').hidden = false;
            if (errorMessage) el('errorMessage').textContent = errorMessage; // textContent: never inject HTML
            el('failedActions').hidden = false;
            announce('Processing failed. ' + (errorMessage || ''));
        } else if (status === 'completed') {
            announce('Your comic is ready.');
        } else {
            announce(stageNames[stage] + ': ' + title + '.');
        }
    }

    function showDoneActions(comicFolderId, comicId, autoRedirect) {
        var openLink = el('btnOpenComic');
        var editLink = el('btnRedirect');
        openLink.href = '/comic/show/' + encodeURIComponent(comicId);
        editLink.href = '/comic/' + encodeURIComponent(comicFolderId) + '/' + encodeURIComponent(comicId);
        el('doneActions').hidden = false;

        if (!autoRedirect) return;

        // Only auto-redirect when the user watched processing finish on this page
        var seconds = 5;
        el('countdown').textContent = seconds;
        el('redirectInfo').hidden = false;
        countdownTimer = setInterval(function () {
            seconds--;
            el('countdown').textContent = seconds;
            if (seconds <= 0) {
                clearInterval(countdownTimer);
                window.location.href = editLink.href;
            }
        }, 1000);
        editLink.focus();
    }

    el('stayButton').addEventListener('click', function () {
        if (countdownTimer) clearInterval(countdownTimer);
        el('redirectInfo').hidden = true;
        el('btnOpenComic').focus();
    });

    function setPollStatus(text) {
        el('pollStatus').textContent = text;
    }

    function finish() {
        finished = true;
        if (pollTimer) clearTimeout(pollTimer);
        pollTimer = null;
        document.removeEventListener('visibilitychange', onVisibilityChange);
        setPollStatus('Finished');
    }

    function schedule(ms) {
        if (finished) return;
        if (pollTimer) clearTimeout(pollTimer);
        if (document.visibilityState === 'hidden') {
            pollTimer = null;
            setPollStatus('Paused while this tab is in the background');
            return;
        }
        pollTimer = setTimeout(updateStatus, ms);
    }

    function updateStatus() {
        pollTimer = null;
        if (finished || inFlight) return;
        if (document.visibilityState === 'hidden') {
            schedule(0);
            return;
        }
        inFlight = true;
        setPollStatus('Checking...');

        fetch('/ajax/upload/status/' + encodeURIComponent(jobId), { cache: 'no-store', headers: { 'Accept': 'application/json' } })
            .then(function (response) {
                if (response.status === 404 || response.status === 403 || response.status === 401) {
                    var fatal = new Error(response.status === 404 ? 'This upload job no longer exists.' : 'You do not have access to this upload, or your session has expired.');
                    fatal.fatal = true;
                    throw fatal;
                }
                if (!response.ok) throw new Error('HTTP ' + response.status);
                return response.json();
            })
            .then(function (data) {
                inFlight = false;
                errorCount = 0;
                el('connectionNotice').hidden = true;
                el('timestamp').textContent = new Date().toLocaleTimeString();
                el('lastUpdate').hidden = false;

                var progress = Number(data.progress) || 0;
                render(data.status, progress, data.errorMessage);

                if (data.status === 'completed') {
                    finish();
                    if (data.comicId && data.comicFolderId) {
                        showDoneActions(data.comicFolderId, data.comicId, sawActiveState);
                    }
                    return;
                }
                if (data.status === 'failed') {
                    finish();
                    return;
                }

                // Back off while nothing changes; snap back when progress moves
                if (data.status !== currentStatus || progress !== lastProgress) {
                    delay = MIN_DELAY;
                } else {
                    delay = Math.min(Math.round(delay * 1.5), MAX_DELAY);
                }
                currentStatus = data.status;
                lastProgress = progress;
                setPollStatus('Checking for updates automatically');
                schedule(delay);
            })
            .catch(function (error) {
                inFlight = false;
                console.error('Error checking status:', error);
                if (error.fatal) {
                    finish();
                    el('connectionNotice').textContent = error.message;
                    el('connectionNotice').hidden = false;
                    setPollStatus('Stopped');
                    return;
                }
                errorCount++;
                var retryIn = Math.min(5000 * Math.pow(2, errorCount - 1), MAX_ERROR_DELAY);
                el('connectionNotice').textContent = 'We could not reach the server. Trying again in ' + Math.round(retryIn / 1000) + ' seconds. Processing continues in the background.';
                el('connectionNotice').hidden = false;
                setPollStatus('Connection problem');
                schedule(retryIn);
            });
    }

    function onVisibilityChange() {
        if (finished) return;
        if (document.visibilityState === 'visible') {
            delay = MIN_DELAY;
            setPollStatus('Checking for updates automatically');
            if (!inFlight) schedule(0);
        } else if (pollTimer) {
            clearTimeout(pollTimer);
            pollTimer = null;
            setPollStatus('Paused while this tab is in the background');
        }
    }

    // ---------- initialise ----------
    render(currentStatus, lastProgress, null);
    quiet = false;

    if (currentStatus === 'completed') {
        finished = true;
        if (statusContainer.dataset.comicId && statusContainer.dataset.comicFolderId) {
            showDoneActions(statusContainer.dataset.comicFolderId, statusContainer.dataset.comicId, false);
        }
    } else if (currentStatus === 'failed') {
        finished = true;
    } else {
        document.addEventListener('visibilitychange', onVisibilityChange);
        schedule(1000);
    }
})();
</script>

<%-include("footer")%>
