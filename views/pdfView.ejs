<%
    var rdTitle = comicTitle || comic_Field.title || 'Untitled comic';
    var rdAuthor = comic_Field.author ? String(comic_Field.author).trim() : '';
    var rdPdfUrl = '/public/uploads/' + encodeURIComponent(savedFolder) + '/' + String(pdfFile).split('/').map(encodeURIComponent).join('/');
    var rdPdfName = String(pdfFile).split('/').pop();
%><!DOCTYPE html>
<html lang="en" class="rd-root rd-pdf-root">
<head>
    <%-include("head_tags")%>
    <link rel="stylesheet" href="/public/css/reader.css?v=20261116m1">
    <title>ComicRoom - <%= rdTitle %></title>
</head>
<body class="reader-body">
    <div class="rd-pdf" id="pdfShell">
        <header class="rd-bar rd-topbar" aria-label="PDF toolbar">
            <a class="rd-btn" href="/comic" aria-label="Back to gallery" title="Back to gallery">
                <i class="fas fa-arrow-left" aria-hidden="true"></i>
            </a>
            <div class="rd-title has-sub">
                <h1 class="rd-title-main" title="<%= rdTitle %>"><%= rdTitle %></h1>
                <span class="rd-title-sub"><%= rdAuthor || 'PDF' %></span>
            </div>
            <%# Phones (< 480px): open + download only; edit and fullscreen need a wider screen. %>
            <div class="rd-actions" role="toolbar" aria-label="PDF options">
                <a class="rd-btn" href="<%= rdPdfUrl %>" target="_blank" rel="noopener" aria-label="Open PDF in a new tab" title="Open in new tab">
                    <i class="fas fa-external-link-alt" aria-hidden="true"></i>
                </a>
                <a class="rd-btn" href="<%= rdPdfUrl %>" download="<%= rdPdfName %>" aria-label="Download PDF" title="Download PDF">
                    <i class="fas fa-download" aria-hidden="true"></i>
                </a>
                <% if (canEditComic) { %>
                <a class="rd-btn rd-hide-sm" href="/comic/<%= encodeURIComponent(comic_Field.savedFolder) %>/<%= comic_Field.id %>" aria-label="Edit comic details" title="Edit comic details">
                    <i class="fas fa-edit" aria-hidden="true"></i>
                </a>
                <% } %>
                <button id="pdfFullscreen" class="rd-btn rd-wide-only rd-fs" type="button" aria-label="Enter fullscreen" title="Fullscreen (F)" hidden>
                    <i class="fas fa-expand" aria-hidden="true"></i>
                </button>
            </div>
        </header>

        <iframe id="pdfFrame" class="rd-pdf-frame" title="<%= rdTitle %> (PDF)" src="<%= rdPdfUrl %>#toolbar=1&amp;navpanes=0&amp;view=FitH"></iframe>

        <div id="pdfFallback" class="rd-pdf-fallback" hidden>
            <i class="fas fa-file-pdf" style="font-size:40px;" aria-hidden="true"></i>
            <p style="margin:0;max-width:340px;">This browser cannot show PDFs inside the page. Open it in the built-in PDF viewer or download it.</p>
            <a class="rd-pill rd-pill-accent" href="<%= rdPdfUrl %>" target="_blank" rel="noopener"><i class="fas fa-external-link-alt" aria-hidden="true"></i> Open PDF</a>
            <a class="rd-pill" href="<%= rdPdfUrl %>" download="<%= rdPdfName %>"><i class="fas fa-download" aria-hidden="true"></i> Download</a>
        </div>
    </div>

    <script>
    (function () {
        var frame = document.getElementById('pdfFrame');
        var fallback = document.getElementById('pdfFallback');
        // Browsers without an inline PDF viewer (most Android browsers) would show
        // a blank frame or start a download: offer explicit actions instead.
        if (navigator.pdfViewerEnabled === false && frame && fallback) {
            frame.parentNode.removeChild(frame);
            fallback.hidden = false;
        }

        var shell = document.getElementById('pdfShell');
        var button = document.getElementById('pdfFullscreen');
        var standalone = false;
        try {
            standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
        } catch (error) {}
        // No Fullscreen API on iPhone Safari; an installed app is already full screen.
        var supported = !!(document.fullscreenEnabled || document.webkitFullscreenEnabled) && !standalone;
        function isFullscreen() {
            return !!(document.fullscreenElement || document.webkitFullscreenElement);
        }
        function sync() {
            if (!button) {
                return;
            }
            var icon = button.querySelector('i');
            if (icon) {
                icon.className = 'fas ' + (isFullscreen() ? 'fa-compress' : 'fa-expand');
            }
            button.setAttribute('aria-label', isFullscreen() ? 'Exit fullscreen' : 'Enter fullscreen');
        }
        function toggle() {
            try {
                var result = isFullscreen()
                    ? (document.exitFullscreen || document.webkitExitFullscreen).call(document)
                    : (shell.requestFullscreen || shell.webkitRequestFullscreen).call(shell);
                if (result && typeof result.catch === 'function') {
                    result.catch(function () {});
                }
            } catch (error) {}
        }
        if (button && supported) {
            button.hidden = false;
            button.addEventListener('click', toggle);
            document.addEventListener('fullscreenchange', sync);
            document.addEventListener('webkitfullscreenchange', sync);
            document.addEventListener('keydown', function (event) {
                var tag = event.target && event.target.tagName;
                if ((event.key === 'f' || event.key === 'F') && !event.ctrlKey && !event.metaKey && !event.altKey && tag !== 'INPUT' && tag !== 'TEXTAREA') {
                    event.preventDefault();
                    toggle();
                }
            });
        }
    })();
    </script>
</body>
</html>
