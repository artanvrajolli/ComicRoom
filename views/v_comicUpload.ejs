<%-include("header")%>
<style>
/* Fallbacks only: :where() has zero specificity so shared comic.css rules win when present. */
:where(.cr-card) {
    background: var(--cr-surface, #1b1b1f);
    border: 1px solid var(--cr-border, #34343b);
    border-radius: var(--cr-radius, 14px);
    box-shadow: var(--cr-shadow, 0 10px 30px rgba(0, 0, 0, .45));
    padding: 1.5rem;
}
:where(.cr-page-title) { font-weight: 700; letter-spacing: -.01em; }
/* Bootstrap display utilities use !important; keep the hidden attribute authoritative */
.up-page [hidden] { display: none !important; }

.up-page {
    max-width: 760px;
    text-align: left;
    font-family: var(--cr-font, inherit);
    color: var(--cr-text, #ededf0);
    /* body already reserves the tab bar; this only makes room for the floating upload bar */
    padding-bottom: var(--up-bar-space, 0px);
}
.up-muted { color: var(--cr-muted, #a6a6b0); }
.up-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: .5rem 1rem; margin-bottom: 1.25rem; }
.up-head p { margin: .25rem 0 0; }
.up-head-link { min-height: 44px; display: inline-flex; align-items: center; gap: .4rem; font-weight: 600; color: var(--cr-accent, #f5a524); text-decoration: none; }
.up-head-link:hover { text-decoration: underline; color: var(--cr-accent, #f5a524); }

.up-dropzone {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    min-height: 220px;
    padding: 2rem 1rem;
    text-align: center;
    cursor: pointer;
    border: 2px dashed var(--cr-border, #3a3a40);
    border-radius: var(--cr-radius, 14px);
    background: var(--cr-surface-2, #26262b);
    color: var(--cr-text, #ededf0);
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
    margin: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
}
.up-dropzone:hover { border-color: var(--cr-accent, #f5a524); }
.up-dropzone:active { background: color-mix(in srgb, var(--cr-accent, #f5a524) 8%, var(--cr-surface-2, #26262b)); }
.up-dropzone:focus-within {
    border-color: var(--cr-accent, #f5a524);
    outline: 3px solid var(--cr-accent, #f5a524);
    outline-offset: 3px;
}
.up-dropzone.is-dragover {
    border-color: var(--cr-accent, #f5a524);
    background: color-mix(in srgb, var(--cr-accent, #f5a524) 12%, var(--cr-surface-2, #26262b));
    transform: scale(1.01);
}
.up-dropzone.is-disabled { cursor: not-allowed; opacity: .55; }
.up-dropzone .up-icon { font-size: 2.75rem; color: var(--cr-accent, #f5a524); }
.up-dropzone .up-browse { color: var(--cr-accent, #f5a524); text-decoration: underline; text-underline-offset: 3px; }
/* Touch-first copy: the drag wording only appears with a precise pointer */
.up-copy-fine { display: none; }
.up-choose-pill {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    min-height: 48px; padding: .6rem 1.4rem; margin-top: .25rem;
    border-radius: 999px; font-weight: 700; font-size: 1.05rem;
    background: var(--cr-accent, #f5a524); color: var(--cr-accent-contrast, #1a1204);
}
@media (hover: hover) and (pointer: fine) {
    .up-copy-fine { display: inline; }
    .up-copy-touch { display: none; }
}

.up-types { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; margin-top: .25rem; }
.up-type {
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .04em;
    padding: .15rem .55rem;
    border-radius: 999px;
    border: 1px solid var(--cr-border, #3a3a40);
    color: var(--cr-muted, #a6a6b0);
}

.up-file {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .6rem .6rem .6rem 1rem;
    border: 1px solid var(--cr-border, #34343b);
    border-radius: var(--cr-radius-sm, 8px);
    background: var(--cr-surface-2, #26262b);
}
.up-file .up-file-icon { font-size: 1.5rem; color: var(--cr-accent, #f5a524); }
.up-file .up-file-name { font-weight: 600; overflow-wrap: anywhere; }
.up-icon-btn { width: 44px; height: 44px; flex: 0 0 44px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }

.up-progress { height: 14px; background: var(--cr-surface-2, #2a2a2f); border-radius: 999px; }
.up-progress .progress-bar { background-color: var(--cr-accent, #f5a524); transition: width .25s linear; }
.up-progress .progress-bar.is-error { background-color: var(--cr-danger, #f87171); }
.up-progress .progress-bar.is-done { background-color: var(--cr-success, #4ade80); }
.up-stats { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; font-size: .875rem; font-variant-numeric: tabular-nums; }
#progressLabel { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }

.up-alert { border-radius: var(--cr-radius-sm, 8px); }
.up-page .fw-semibold { font-weight: 600; }
.up-page .min-w-0 { min-width: 0; }
.up-notes { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-direction: column; gap: .5rem; font-size: .875rem; }
.up-notes li { display: flex; gap: .6rem; align-items: flex-start; }
.up-notes i { margin-top: .2rem; width: 1rem; text-align: center; color: var(--cr-muted, #a6a6b0); }

.up-page .btn { min-height: 44px; border-radius: var(--cr-radius-sm, 8px); }
.up-page .btn-accent {
    background: var(--cr-accent, #f5a524);
    border-color: var(--cr-accent, #f5a524);
    color: var(--cr-accent-contrast, #1a1204);
    font-weight: 600;
}
.up-page .btn-accent:hover:not(:disabled) { filter: brightness(1.08); }
.up-page .btn:focus-visible { outline: 3px solid var(--cr-accent, #f5a524); outline-offset: 2px; box-shadow: none; }
.up-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }

/* Phones and tablets: touch-sized controls and a floating progress/action bar above the tab bar */
@media (max-width: 991.98px) {
    .up-dropzone { min-height: 0; padding: 1.75rem 1rem; }
    .up-dropzone .up-icon { font-size: 2.25rem; }
    .up-page .cr-card { padding: 1rem; }
    .up-bar.is-floating {
        position: fixed;
        left: 0;
        right: 0;
        bottom: calc(var(--cr-bottom-nav-h, 0px) + env(safe-area-inset-bottom, 0px));
        z-index: 1020;
        padding: .75rem max(1rem, env(safe-area-inset-left, 0px)) .75rem max(1rem, env(safe-area-inset-right, 0px));
        background: color-mix(in srgb, var(--cr-surface, #1b1b1f) 96%, transparent);
        border-top: 1px solid var(--cr-border, #34343b);
        box-shadow: 0 -8px 24px rgba(0, 0, 0, .45);
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
    }
    .up-bar.is-floating > * { max-width: 728px; margin-left: auto; margin-right: auto; }
    .up-bar.is-floating #progressSection { margin-top: 0 !important; margin-bottom: .6rem; }
    .up-bar.is-floating .up-progress { height: 10px; }
    .up-bar.is-floating .up-stats { font-size: .8rem; margin-top: .3rem !important; }
    .up-bar.is-floating .up-actions { margin-top: 0; }
    .up-actions { flex-wrap: nowrap; }
    .up-actions .btn { flex: 1 1 0; min-height: 50px; font-size: 1.05rem; }
    /* Nothing to act on yet: the "Choose a comic file" pill is the only call to action */
    .up-bar:not(.is-floating) { display: none; }
    /* While sending, the disabled "Uploading..." button adds nothing; Cancel gets the full width */
    .up-bar.is-uploading #uploadButton { display: none; }
    .up-actions .btn { white-space: nowrap; }
    /* The bar's main button continues a stopped upload, so the inline retry is redundant here */
    #retryButton { display: none !important; }
}
@media (max-width: 575.98px) {
    .up-head-link { width: 100%; }
}

@media (prefers-reduced-motion: reduce) {
    .up-dropzone, .up-progress .progress-bar { transition: none; }
    .up-dropzone.is-dragover { transform: none; }
    .up-page .progress-bar-animated { animation: none; }
}
</style>

<div class="container content_c mt-4 mb-5 up-page" id="uploadPage">
    <div class="up-head">
        <div class="min-w-0">
            <h1 class="cr-page-title h3 mb-0">Upload a comic</h1>
            <p class="up-muted">CBZ, CBR or PDF, up to 2 GB. Large files are sent in small parts, so a dropped connection does not mean starting over.</p>
        </div>
        <a class="up-head-link" href="/comic/uploads"><i class="fas fa-list-ul" aria-hidden="true"></i> Your uploads</a>
    </div>

    <% if(typeof msg != 'undefined' && msg != ""){ %>
    <div class="alert alert-warning up-alert" role="alert"><%=msg%></div>
    <% } %>

    <section class="cr-card" aria-labelledby="uploadCardTitle">
        <h2 id="uploadCardTitle" class="visually-hidden">Choose a file</h2>
        <form id="uploadForm" method="post" enctype="multipart/form-data" onsubmit="return false;" novalidate>
            <label class="up-dropzone" id="dropzone" for="file1">
                <i class="fas fa-cloud-upload-alt up-icon" aria-hidden="true"></i>
                <span class="up-copy-touch">
                    <span class="up-choose-pill"><i class="fas fa-folder-open" aria-hidden="true"></i> Choose a comic file</span>
                </span>
                <span class="up-copy-fine">
                    <span class="fs-5 fw-semibold d-block">Drag your comic here</span>
                    <span class="up-muted">or <span class="up-browse">browse your files</span></span>
                </span>
                <span class="up-types" aria-label="Accepted file types">
                    <span class="up-type">CBZ</span>
                    <span class="up-type">CBR</span>
                    <span class="up-type">PDF</span>
                </span>
                <span class="small up-muted">Maximum file size: 2 GB</span>
                <input name="fileComicUpload" id="file1" type="file" class="visually-hidden"
                       accept=".cbz,.cbr,.pdf,application/zip,application/x-cbz,application/vnd.comicbook+zip,application/x-rar-compressed,application/vnd.rar,application/vnd.comicbook-rar,application/x-cbr,application/pdf"
                       aria-describedby="fileHelp">
            </label>
            <p id="fileHelp" class="visually-hidden">Accepted types: CBZ, CBR or PDF, up to 2 GB.</p>

            <div id="fileSummary" class="up-file mt-3" hidden>
                <i id="fileIcon" class="fas fa-file-archive up-file-icon" aria-hidden="true"></i>
                <div class="flex-grow-1 min-w-0">
                    <div id="fileName" class="up-file-name"></div>
                    <div id="fileSize" class="small up-muted"></div>
                </div>
                <button type="button" id="clearFileButton" class="btn btn-outline-light up-icon-btn" aria-label="Remove selected file">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>

            <div id="errorBox" class="alert alert-danger up-alert mt-3 d-flex gap-2 align-items-start" role="alert" hidden>
                <i class="fas fa-exclamation-triangle mt-1" aria-hidden="true"></i>
                <div class="flex-grow-1">
                    <div id="errorText"></div>
                    <button type="button" id="retryButton" class="btn btn-sm btn-light mt-2" hidden>
                        <i class="fas fa-redo" aria-hidden="true"></i> Retry upload
                    </button>
                </div>
            </div>

            <!-- Status messages for screen readers and sighted users -->
            <p id="status" class="mt-3 mb-0 up-muted" role="status" aria-live="polite"></p>

            <!-- On phones this becomes a bar fixed above the bottom tab bar once a file is chosen -->
            <div id="uploadBar" class="up-bar">
                <div id="progressSection" class="mt-4" hidden>
                    <div class="d-flex justify-content-between align-items-baseline gap-2 mb-2">
                        <span id="progressLabel" class="fw-semibold">Uploading</span>
                        <span id="progressPercent" class="fw-bold" aria-hidden="true">0%</span>
                    </div>
                    <div class="progress up-progress" id="progressWrap" role="progressbar" aria-labelledby="progressLabel" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%"></div>
                    </div>
                    <div class="up-stats up-muted mt-2">
                        <span id="loaded_n_total"></span>
                        <span id="speedText"></span>
                        <span id="etaText"></span>
                    </div>
                </div>

                <div class="up-actions">
                    <button type="button" id="uploadButton" class="btn btn-accent px-4" onclick="uploadFile()" disabled>
                        <i class="fas fa-file-upload" aria-hidden="true"></i> <span>Upload</span>
                    </button>
                    <button type="button" id="cancelButton" class="btn btn-outline-light" hidden>
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel upload
                    </button>
                </div>
            </div>

            <div hidden class="mt-3">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="uploadMethod" id="chunkedUpload" value="chunked" checked>
                    <label class="form-check-label" for="chunkedUpload">
                        <strong>Chunked Upload</strong> (Recommended for large files or slow connections)
                    </label>
                </div>
                <br>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="uploadMethod" id="regularUpload" value="regular">
                    <label class="form-check-label" for="regularUpload">
                        <strong>Regular Upload</strong> (For smaller files with stable connection)
                    </label>
                </div>
            </div>
        </form>
    </section>

    <ul class="up-notes up-muted">
        <li id="keepOpenNote">
            <i class="fas fa-mobile-alt" aria-hidden="true"></i>
            <span>Keep ComicRoom open until the upload finishes. Switching apps or locking your phone can pause it; when you come back it continues from where it stopped.</span>
        </li>
        <li>
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            <span>After the upload, the comic is extracted on the server. You can follow it on the status page or in <a href="/comic/uploads">your uploads</a>, and edit the title, author and description when it is ready.</span>
        </li>
        <li id="shareTargetNote" hidden>
            <i class="fas fa-share-alt" aria-hidden="true"></i>
            <span>With ComicRoom installed, you can also share a comic file to it from your file manager.</span>
        </li>
    </ul>
</div>

<script>
(function () {
    function _(el) {
        return document.getElementById(el);
    }

    // Chunked upload configuration (protocol unchanged: POST /comic/upload-chunk)
    var CHUNK_SIZE = 5 * 1024 * 1024; // 5MB chunks
    var MAX_RETRIES = 3;
    var MAX_FILE_SIZE = 2 * 1024 * 1024 * 1024; // 2GB, matches server limit
    var ALLOWED_EXTENSIONS = ['cbz', 'cbr', 'pdf'];

    var fileInput = _('file1');
    var dropzone = _('dropzone');
    var uploadButton = _('uploadButton');
    var cancelButton = _('cancelButton');
    var retryButton = _('retryButton');
    var clearFileButton = _('clearFileButton');

    var selectedFile = null;
    var isUploading = false;
    var cancelRequested = false;
    var currentXhr = null;
    var resumeState = null; // { file, uploadId, totalChunks, nextChunk }
    var speedSamples = [];
    var uploadBar = _('uploadBar');
    var autoResume = false;      // resume automatically when the page becomes visible again
    var hiddenDuringUpload = false;
    var wakeLock = null;

    // iOS greys out files whose type it cannot map from accept (.cbz/.cbr usually), so let
    // every file through there; the extension is validated below and again on the server.
    var isIOS = /iP(hone|ad|od)/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    if (isIOS) fileInput.removeAttribute('accept');

    // Android: mention the share target only when the installed manifest offers one
    if (/Android/i.test(navigator.userAgent) && window.fetch) {
        var manifestLink = document.querySelector('link[rel="manifest"]');
        if (manifestLink) {
            fetch(manifestLink.href, { credentials: 'same-origin' })
                .then(function (r) { return r.ok ? r.json() : null; })
                .then(function (m) { if (m && m.share_target) _('shareTargetNote').hidden = false; })
                .catch(function () {});
        }
    }

    // ---------- screen wake lock (keeps the phone awake mid-upload) ----------
    function requestWakeLock() {
        if (!('wakeLock' in navigator) || wakeLock || document.visibilityState !== 'visible') return;
        navigator.wakeLock.request('screen').then(function (lock) {
            if (!isUploading) { lock.release().catch(function () {}); return; }
            wakeLock = lock;
            lock.addEventListener('release', function () { if (wakeLock === lock) wakeLock = null; });
        }).catch(function () { /* denied (battery saver, iframe, ...) - uploads still work */ });
    }
    function releaseWakeLock() {
        if (!wakeLock) return;
        var lock = wakeLock;
        wakeLock = null;
        lock.release().catch(function () {});
    }

    // ---------- floating action bar on phones ----------
    var barQuery = window.matchMedia ? window.matchMedia('(max-width: 991.98px)') : null;
    function updateBar() {
        var floating = !!(barQuery && barQuery.matches) && (isUploading || !!selectedFile || !!resumeState);
        uploadBar.classList.toggle('is-floating', floating);
        uploadBar.classList.toggle('is-uploading', isUploading);
        document.getElementById('uploadPage').style.setProperty('--up-bar-space', floating ? uploadBar.offsetHeight + 'px' : '0px');
    }
    if (barQuery) {
        if (barQuery.addEventListener) barQuery.addEventListener('change', updateBar);
        else if (barQuery.addListener) barQuery.addListener(updateBar);
    }
    if (window.ResizeObserver) new ResizeObserver(function () { updateBar(); }).observe(uploadBar);

    function updateUploadLabel() {
        if (isUploading) return;
        uploadButton.querySelector('span').textContent = resumeState ? 'Resume upload' : 'Upload';
    }

    // ---------- helpers ----------
    function formatBytes(bytes) {
        if (!bytes && bytes !== 0) return '';
        var units = ['B', 'KB', 'MB', 'GB'];
        var i = 0;
        var value = bytes;
        while (value >= 1024 && i < units.length - 1) {
            value /= 1024;
            i++;
        }
        return value.toFixed(i === 0 ? 0 : (value < 10 ? 2 : 1)) + ' ' + units[i];
    }

    function formatDuration(seconds) {
        if (!isFinite(seconds) || seconds < 0) return '';
        seconds = Math.round(seconds);
        if (seconds < 60) return seconds + 's';
        var minutes = Math.floor(seconds / 60);
        var rest = seconds % 60;
        if (minutes < 60) return minutes + 'm ' + (rest < 10 ? '0' : '') + rest + 's';
        var hours = Math.floor(minutes / 60);
        return hours + 'h ' + (minutes % 60) + 'm';
    }

    function getExtension(name) {
        var parts = String(name || '').toLowerCase().split('.');
        return parts.length > 1 ? parts.pop() : '';
    }

    function setStatus(text) {
        _('status').textContent = text || '';
    }

    function showError(text, canRetry) {
        _('errorText').textContent = text;
        retryButton.hidden = !canRetry;
        _('errorBox').hidden = false;
    }

    function hideError() {
        _('errorBox').hidden = true;
        _('errorText').textContent = '';
        retryButton.hidden = true;
    }

    function setProgress(percent, state) {
        var value = Math.max(0, Math.min(100, percent));
        var rounded = Math.floor(value);
        var bar = _('progressBar');
        bar.style.width = value.toFixed(1) + '%';
        _('progressPercent').textContent = rounded + '%';
        _('progressWrap').setAttribute('aria-valuenow', String(rounded));
        _('progressWrap').setAttribute('aria-valuetext', rounded + '% uploaded');
        bar.classList.toggle('is-error', state === 'error');
        bar.classList.toggle('is-done', state === 'done');
        bar.classList.toggle('progress-bar-animated', state === 'active');
    }

    function setUploading(active) {
        isUploading = active;
        fileInput.disabled = active;
        dropzone.classList.toggle('is-disabled', active);
        dropzone.setAttribute('aria-disabled', active ? 'true' : 'false');
        clearFileButton.disabled = active;
        uploadButton.disabled = active || !selectedFile;
        uploadButton.querySelector('span').textContent = active ? 'Uploading...' : 'Upload';
        cancelButton.hidden = !active;
        cancelButton.disabled = false;
        if (active) {
            hiddenDuringUpload = document.visibilityState === 'hidden';
            window.addEventListener('beforeunload', beforeUnloadHandler);
            requestWakeLock();
        } else {
            window.removeEventListener('beforeunload', beforeUnloadHandler);
            releaseWakeLock();
        }
        updateBar();
    }

    function beforeUnloadHandler(event) {
        if (!isUploading) return undefined;
        event.preventDefault();
        event.returnValue = 'An upload is in progress. Leaving now will cancel it.';
        return event.returnValue;
    }

    // ---------- file selection & validation ----------
    function validateFile(file) {
        if (!file) return 'Please select a file first.';
        if (ALLOWED_EXTENSIONS.indexOf(getExtension(file.name)) === -1) {
            return '"' + file.name + '" is not a supported file. Choose a .cbz, .cbr or .pdf file.';
        }
        if (file.size === 0) return 'This file is empty. Choose a different file.';
        if (file.size > MAX_FILE_SIZE) {
            return 'This file is ' + formatBytes(file.size) + '. The maximum upload size is 2 GB.';
        }
        return '';
    }

    function selectFile(file) {
        if (isUploading) return;
        hideError();
        resumeState = null;
        _('progressSection').hidden = true;
        setStatus('');

        if (!file) {
            clearSelection();
            return;
        }

        var error = validateFile(file);
        _('fileName').textContent = file.name;
        _('fileSize').textContent = formatBytes(file.size);
        _('fileIcon').className = (getExtension(file.name) === 'pdf' ? 'fas fa-file-pdf' : 'fas fa-file-archive') + ' up-file-icon';
        _('fileSummary').hidden = false;

        autoResume = false;
        if (error) {
            selectedFile = null;
            uploadButton.disabled = true;
            updateUploadLabel();
            updateBar();
            showError(error, false);
            return;
        }

        selectedFile = file;
        uploadButton.disabled = false;
        updateUploadLabel();
        updateBar();
        setStatus('Ready to upload ' + file.name + ' (' + formatBytes(file.size) + ').');
    }

    function clearSelection() {
        selectedFile = null;
        resumeState = null;
        fileInput.value = '';
        _('fileSummary').hidden = true;
        _('progressSection').hidden = true;
        uploadButton.disabled = true;
        autoResume = false;
        hideError();
        updateUploadLabel();
        updateBar();
        setStatus('');
    }

    fileInput.addEventListener('change', function () {
        selectFile(fileInput.files && fileInput.files[0]);
    });

    clearFileButton.addEventListener('click', function () {
        clearSelection();
        fileInput.focus();
    });

    // Drag and drop
    var dragDepth = 0;
    ['dragenter', 'dragover'].forEach(function (type) {
        dropzone.addEventListener(type, function (event) {
            event.preventDefault();
            if (isUploading) {
                event.dataTransfer.dropEffect = 'none';
                return;
            }
            if (type === 'dragenter') dragDepth++;
            event.dataTransfer.dropEffect = 'copy';
            dropzone.classList.add('is-dragover');
        });
    });
    dropzone.addEventListener('dragleave', function () {
        dragDepth = Math.max(0, dragDepth - 1);
        if (dragDepth === 0) dropzone.classList.remove('is-dragover');
    });
    dropzone.addEventListener('drop', function (event) {
        event.preventDefault();
        dragDepth = 0;
        dropzone.classList.remove('is-dragover');
        if (isUploading) return;
        var files = event.dataTransfer && event.dataTransfer.files;
        if (!files || files.length === 0) return;
        if (files.length > 1) {
            showError('Drop one file at a time.', false);
            return;
        }
        try {
            // Keep the native input in sync where the browser allows it
            var transfer = new DataTransfer();
            transfer.items.add(files[0]);
            fileInput.files = transfer.files;
        } catch (e) { /* older browsers: selectedFile is still used */ }
        selectFile(files[0]);
    });
    // Avoid the browser opening the file when it is dropped outside the zone
    window.addEventListener('dragover', function (event) { event.preventDefault(); });
    window.addEventListener('drop', function (event) { event.preventDefault(); });

    // ---------- upload entry point ----------
    function uploadFile() {
        if (isUploading) return;
        var file = selectedFile || (fileInput.files && fileInput.files[0]);
        var error = validateFile(file);
        if (error) {
            showError(error, false);
            setStatus(error);
            return;
        }
        hideError();
        autoResume = false;

        // After a stopped upload the main button continues from the last confirmed part
        if (resumeState && resumeState.file === file) {
            startChunkedUpload(file, resumeState);
            return;
        }

        var methodInput = document.querySelector('input[name="uploadMethod"]:checked');
        var uploadMethod = methodInput ? methodInput.value : 'chunked';
        if (uploadMethod === 'chunked') {
            startChunkedUpload(file, null);
        } else {
            startRegularUpload(file);
        }
    }
    window.uploadFile = uploadFile;

    retryButton.addEventListener('click', function () {
        if (isUploading) return;
        hideError();
        autoResume = false;
        if (resumeState) {
            startChunkedUpload(resumeState.file, resumeState);
        } else {
            uploadFile();
        }
    });

    cancelButton.addEventListener('click', function () {
        if (!isUploading) return;
        cancelRequested = true;
        cancelButton.disabled = true;
        setStatus('Cancelling upload...');
        if (currentXhr) currentXhr.abort();
    });

    // ---------- progress / speed / ETA ----------
    function resetSpeed() {
        speedSamples = [];
    }

    function recordProgress(loadedBytes, totalBytes) {
        var now = Date.now();
        speedSamples.push({ t: now, b: loadedBytes });
        // keep roughly the last 8 seconds of samples
        while (speedSamples.length > 2 && now - speedSamples[0].t > 8000) {
            speedSamples.shift();
        }
        var percent = totalBytes ? (loadedBytes / totalBytes) * 100 : 0;
        setProgress(percent, 'active');
        _('loaded_n_total').textContent = formatBytes(loadedBytes) + ' of ' + formatBytes(totalBytes);

        var first = speedSamples[0];
        var elapsed = (now - first.t) / 1000;
        if (elapsed >= 1 && loadedBytes > first.b) {
            var speed = (loadedBytes - first.b) / elapsed;
            _('speedText').textContent = formatBytes(speed) + '/s';
            var eta = formatDuration((totalBytes - loadedBytes) / speed);
            _('etaText').textContent = eta ? 'about ' + eta + ' left' : '';
        }
    }

    // ---------- chunked upload ----------
    async function startChunkedUpload(file, resume) {
        var uploadId = resume ? resume.uploadId : 'upload_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        var totalChunks = resume ? resume.totalChunks : Math.ceil(file.size / CHUNK_SIZE);
        var startChunk = resume ? resume.nextChunk : 0;
        var jobId = null;

        cancelRequested = false;
        resumeState = null;
        resetSpeed();
        setUploading(true);
        _('progressSection').hidden = false;
        _('progressLabel').textContent = 'Uploading ' + file.name;
        _('speedText').textContent = '';
        _('etaText').textContent = '';
        recordProgress(startChunk * CHUNK_SIZE, file.size);
        setStatus(resume ? 'Resuming upload from part ' + (startChunk + 1) + ' of ' + totalChunks + '.' : 'Upload started.');

        var lastAnnounced = -1;
        for (var chunkIndex = startChunk; chunkIndex < totalChunks; chunkIndex++) {
            try {
                var result = await uploadChunkWithRetry(file, chunkIndex, totalChunks, uploadId, CHUNK_SIZE);
                if (result && result.status === 'complete' && result.jobId) {
                    jobId = result.jobId;
                }
                var done = Math.min((chunkIndex + 1) * CHUNK_SIZE, file.size);
                recordProgress(done, file.size);
                // Announce progress to screen readers in 25% steps only
                var quarter = Math.floor((done / file.size) * 4);
                if (quarter !== lastAnnounced && quarter < 4) {
                    lastAnnounced = quarter;
                    setStatus(Math.floor((done / file.size) * 100) + '% uploaded.');
                }
            } catch (error) {
                currentXhr = null;
                setUploading(false);
                if (error && error.cancelled) {
                    setProgress(0, 'error');
                    _('progressSection').hidden = true;
                    _('speedText').textContent = '';
                    _('etaText').textContent = '';
                    updateUploadLabel();
                    updateBar();
                    setStatus('Upload cancelled. Your file is still selected; press Upload to start again.');
                    return;
                }
                console.error('Failed to upload chunk ' + chunkIndex + ':', error);
                setProgress((chunkIndex * CHUNK_SIZE / file.size) * 100, 'error');
                var fatal = error && error.fatal;
                if (!fatal) {
                    resumeState = { file: file, uploadId: uploadId, totalChunks: totalChunks, nextChunk: chunkIndex };
                }
                var message = (error && error.message) ? error.message : 'Unknown error.';
                if (!/[.!?]$/.test(message)) message += '.';
                _('speedText').textContent = '';
                _('etaText').textContent = '';
                _('loaded_n_total').textContent = formatBytes(chunkIndex * CHUNK_SIZE) + ' of ' + formatBytes(file.size) + ' sent';
                _('progressLabel').textContent = fatal ? 'Upload failed' : 'Upload stopped';
                updateUploadLabel();
                updateBar();
                if (fatal) {
                    showError('The server did not accept this upload: ' + message, false);
                } else if (hiddenDuringUpload || document.visibilityState === 'hidden') {
                    // Most likely the phone suspended the page; carry on once it is back in front
                    autoResume = document.visibilityState === 'hidden';
                    showError('The upload paused at ' + Math.floor((chunkIndex * CHUNK_SIZE / file.size) * 100) + '% while ComicRoom was in the background. ' + (autoResume ? 'It continues when you return.' : 'Tap Resume upload to continue from where it stopped.'), true);
                } else {
                    showError('The upload stopped at ' + Math.floor((chunkIndex * CHUNK_SIZE / file.size) * 100) + '%. ' + message + ' Resume continues from where it stopped.', true);
                }
                setStatus('Upload failed.');
                var box = _('errorBox');
                // centre it: "nearest" would leave it under the floating bar on phones
                if (box.scrollIntoView) box.scrollIntoView({ block: 'center', behavior: 'smooth' });
                return;
            }
        }

        currentXhr = null;
        setProgress(100, 'done');
        _('speedText').textContent = '';
        _('etaText').textContent = '';
        _('progressLabel').textContent = 'Upload complete';
        isUploading = false;
        releaseWakeLock();
        window.removeEventListener('beforeunload', beforeUnloadHandler);
        cancelButton.hidden = true;
        uploadButton.querySelector('span').textContent = 'Uploaded';
        updateBar();
        setStatus('Upload complete. Opening the processing status page...');

        setTimeout(function () {
            window.location.href = jobId ? '/comic/status/' + encodeURIComponent(jobId) : '/comic';
        }, 900);
    }

    function wait(ms) {
        return new Promise(function (resolve, reject) {
            var elapsed = 0;
            var timer = setInterval(function () {
                elapsed += 200;
                if (cancelRequested) {
                    clearInterval(timer);
                    var err = new Error('Upload cancelled');
                    err.cancelled = true;
                    reject(err);
                } else if (elapsed >= ms) {
                    clearInterval(timer);
                    resolve();
                }
            }, 200);
        });
    }

    async function uploadChunkWithRetry(file, chunkIndex, totalChunks, uploadId, chunkSize) {
        var retries = 0;
        while (true) {
            try {
                return await uploadChunk(file, chunkIndex, totalChunks, uploadId, chunkSize);
            } catch (error) {
                if (error.cancelled || error.fatal) throw error;
                retries++;
                if (retries >= MAX_RETRIES) throw error;
                var delay = Math.pow(2, retries) * 1000;
                setStatus('Connection problem (' + error.message + '). Retrying in ' + (delay / 1000) + 's...');
                await wait(delay);
            }
        }
    }

    function uploadChunk(file, chunkIndex, totalChunks, uploadId, chunkSize) {
        return new Promise(function (resolve, reject) {
            if (cancelRequested) {
                var c = new Error('Upload cancelled');
                c.cancelled = true;
                reject(c);
                return;
            }
            var start = chunkIndex * chunkSize;
            var end = Math.min(start + chunkSize, file.size);
            var chunk = file.slice(start, end);

            var formdata = new FormData();
            formdata.append("chunk", chunk);
            formdata.append("chunkIndex", chunkIndex);
            formdata.append("totalChunks", totalChunks);
            formdata.append("fileName", file.name);
            formdata.append("uploadId", uploadId);

            var xhr = new XMLHttpRequest();
            currentXhr = xhr;
            var isLastChunk = chunkIndex === totalChunks - 1;
            // 60s per chunk; the last one also waits for the server to assemble the file
            xhr.timeout = isLastChunk ? 10 * 60 * 1000 : 60000;

            if (isLastChunk) {
                xhr.upload.onload = function () {
                    _('progressLabel').textContent = 'Finishing upload on the server...';
                    setStatus('All data sent. The server is putting the file together...');
                };
            }

            xhr.upload.onprogress = function (event) {
                if (!event.lengthComputable) return;
                var sent = Math.min(event.loaded / event.total, 1) * (end - start);
                recordProgress(start + sent, file.size);
            };

            xhr.onload = function () {
                var data = null;
                try { data = JSON.parse(xhr.responseText); } catch (e) { data = null; }
                if (xhr.status === 200) {
                    if (data) resolve(data);
                    else reject(new Error('The server sent an unexpected response.'));
                    return;
                }
                var err;
                if (xhr.status === 401) {
                    err = new Error('Your session has expired. Log in again in another tab, then retry.');
                } else if (xhr.status === 413) {
                    err = new Error('The server rejected this part as too large.');
                    err.fatal = true;
                } else if (xhr.status === 400) {
                    err = new Error((data && data.error) ? data.error : 'The server rejected the upload.');
                    err.fatal = true;
                } else {
                    err = new Error((data && data.error) ? data.error : 'Server error (HTTP ' + xhr.status + ').');
                }
                reject(err);
            };

            xhr.onerror = function () { reject(new Error('Network error. Check your connection.')); };
            xhr.ontimeout = function () { reject(new Error('The server took too long to respond.')); };
            xhr.onabort = function () {
                var err = new Error('Upload cancelled');
                err.cancelled = true;
                reject(err);
            };

            xhr.open("POST", "/comic/upload-chunk");
            xhr.send(formdata);
        });
    }

    // ---------- background / foreground ----------
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') {
            if (isUploading) hiddenDuringUpload = true;
            return;
        }
        // The browser drops the wake lock whenever the page is hidden
        if (isUploading) requestWakeLock();
        if (autoResume && resumeState && !isUploading) {
            autoResume = false;
            hideError();
            setStatus('Welcome back. Resuming the upload...');
            startChunkedUpload(resumeState.file, resumeState);
        }
    });

    // ---------- regular (single request) upload, kept as a fallback ----------
    function startRegularUpload(file) {
        cancelRequested = false;
        resetSpeed();
        setUploading(true);
        _('progressSection').hidden = false;
        _('progressLabel').textContent = 'Uploading ' + file.name;
        setStatus('Upload started.');

        var formdata = new FormData();
        formdata.append("fileComicUpload", file);
        var ajax = new XMLHttpRequest();
        currentXhr = ajax;
        ajax.upload.addEventListener("progress", function (event) {
            if (event.lengthComputable) recordProgress(event.loaded, event.total);
        }, false);
        ajax.addEventListener("load", function (event) {
            currentXhr = null;
            setUploading(false);
            if (event.target.status === 200) {
                setProgress(100, 'done');
                setStatus('Upload successful. Redirecting...');
                location.replace(event.target.responseURL);
            } else {
                setProgress(0, 'error');
                showError('Upload failed (HTTP ' + event.target.status + ').', true);
            }
        }, false);
        ajax.addEventListener("error", function () {
            currentXhr = null;
            setUploading(false);
            setProgress(0, 'error');
            showError('Network error. Check your connection.', true);
        }, false);
        ajax.addEventListener("abort", function () {
            currentXhr = null;
            setUploading(false);
            _('progressSection').hidden = true;
            setStatus('Upload cancelled.');
        }, false);
        ajax.open("POST", "/comic/upload");
        ajax.send(formdata);
    }
})();
</script>
<%-include("footer")%>
