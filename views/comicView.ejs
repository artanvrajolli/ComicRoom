<!DOCTYPE html>
<html lang="en">
<head>
    <%-include("head_tags")%>
    <title>ComicRoom - <%=comic_Field.title%></title>
    <style>
        html, body {
            min-height: 100%;
            background-color: #111;
        }

        .reader-overlay {
            position: fixed;
            z-index: 5;
        }

        .reader-toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 6px 10px;
            border-radius: 10px;
            background-color: rgba(36, 36, 36, 0.55);
        }

        .reader-mode-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 84px;
            padding: 6px 10px;
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 999px;
            color: #d3d3d3;
            background-color: rgba(255,255,255,0.05);
            font-size: 13px;
            text-decoration: none;
            cursor: pointer;
        }

        .reader-mode-button.active {
            color: #111;
            background-color: #f8f9fa;
            border-color: #f8f9fa;
        }

        .paged-reader-shell {
            height: 100vh;
            height: 100dvh;
            width: 100%;
            padding: 0;
            position: relative;
            overflow: hidden;
            touch-action: none;
            user-select: none;
            -webkit-user-select: none;
        }

        #mainImage {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            object-position: center;
            image-rendering: auto;
            transform-origin: center center;
            will-change: transform;
        }

        .paged-reader-shell.is-zoomed #mainImage {
            cursor: grab;
        }

        .paged-reader-shell.is-panning #mainImage {
            cursor: grabbing;
        }

        .reader-side-trigger {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 50%;
            z-index: 3;
            display: flex;
            align-items: center;
            cursor: pointer;
            transition: background-color 0.15s ease-in-out;
        }

        .reader-side-trigger i {
            font-size: 40px;
            color: rgba(255, 255, 255, 0.45);
        }

        #leftTrigger {
            left: 0;
            justify-content: flex-start;
            padding-left: 12px;
        }

        #rightTrigger {
            right: 0;
            justify-content: flex-end;
            padding-right: 12px;
        }

        .reader-side-trigger:hover {
            background-color: rgba(255,255,255,0.03);
        }

        #scrollReader {
            display: none;
            width: 100%;
            padding: 72px 0 24px 0;
        }

        .scroll-page {
            width: 100%;
            max-width: 100%;
            margin: 0 0 18px 0;
            display: flex;
            justify-content: center;
        }

        .scroll-page img {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: 100vh;
            max-height: 100dvh;
            object-fit: contain;
            display: block;
            background-color: #111;
        }

        @media (hover: none) and (pointer: coarse) {
            .reader-side-trigger {
                width: 25%;
            }
        }

        @media (max-width: 768px) {
            .reader-overlay {
                font-size: 18px !important;
                opacity: 0.55 !important;
            }

            .reader-overlay b {
                font-size: 15px !important;
                margin-right: 5px !important;
            }

            .reader-toolbar {
                gap: 4px;
                padding: 3px 6px;
                border-radius: 8px;
                max-width: calc(100vw - 72px);
            }

            .reader-mode-button {
                min-width: 50px;
                padding: 3px 7px;
                font-size: 11px;
            }

            .reader-toolbar a:not(.reader-mode-button) {
                font-size: 20px !important;
            }

            .reader-toolbar .mx-1,
            .reader-toolbar .mx-2 {
                margin-left: 4px !important;
                margin-right: 4px !important;
            }

            .reader-side-trigger i {
                font-size: 28px;
            }

            #leftTrigger {
                padding-left: 8px;
            }

            #rightTrigger {
                padding-right: 8px;
            }

            #scrollReader {
                padding: 52px 0 12px 0;
            }

            .scroll-page {
                margin-bottom: 8px;
            }
        }
    </style>
</head>
    <body class="h-100 text-white bg-dark" data-comic-images="<%- encodeURIComponent(JSON.stringify(comicImages)) %>" data-comic-id="<%=comic_Field.id%>" data-comic-folder="<%-savedFolder%>" data-page-number="<%=pageNumber%>">
        <div class="reader-overlay d-flex" style="font-size:30px;opacity: 0.65;left:4px;top:4px;">
            <b style="font-size: 25px;margin-right: 10px;">
                <a id="currentPage">999</a>/<a id="totalPage">999</a>
            </b>
        </div>
        <div class="reader-overlay d-flex" style="font-size:30px;right:5px;top:4px;">
            <div class="reader-toolbar">
                <a id="pagedModeButton" class="reader-mode-button active">Paged</a>
                <a id="scrollModeButton" class="reader-mode-button">Scroll</a>
            <a id="zoomToggle" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);" title="Zoom page" aria-label="Zoom page">
                <i class="mx-2 fas fa-search-plus"></i>
            </a>
            <a id="offlineToggle" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);" title="Save comic for offline reading" aria-label="Save comic for offline reading">
                <i class="mx-2 fas fa-cloud-download-alt"></i>
            </a>
            <a id="backToStart" style="font-size: 30px;cursor: pointer;display: none;">
                <i class="mx-2 fas fa-undo-alt"></i>
            </a>
            <% if(canEditComic){ %>
            <a href="/comic/<%= comic_Field.savedFolder %>/<%= comic_Field.id %>" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);">
                <i class="mx-2 fas fa-edit"></i>
            </a>
            <% } %>
            <a id="fullScreen_icon" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);">
                <i class="mx-2 fas fa-expand"></i>
            </a>
            <a id="infoComic_details" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);">
                <i class="mx-1 fas fa-info-circle"></i>
             </a>

            <a id="backToComics" style="font-size: 30px;cursor: pointer;color: rgb(134 134 134 / 0.7);">
             <i class="mx-2 fas fa-times"></i>
            </a>
            </div>
        </div>

        <div id="pagedReader" class="container-fluid d-flex justify-content-center align-items-center paged-reader-shell">

            <div class="reader-side-trigger" id="leftTrigger">
                <i style="cursor: pointer;" class="fas fa-arrow-circle-left align-self-center"></i>
            </div>
            <!-- transform: scale3d(1, 1, 1); -->
            <img onload="cacheNextImage()" class="img-fluid" id="mainImage" src="">

            <img id="cachedImage" src="" style="height: 1px; width:1px;" />
            <div class="reader-side-trigger" id="rightTrigger">
                <i style="cursor: pointer;" class="fas fa-arrow-circle-right align-self-center"></i>
            </div>

        </div>
        <div id="scrollReader" class="container-fluid">
            <% comicImages.forEach((comicImage, index)=>{ %>
                <div class="scroll-page" data-page-index="<%= index %>">
                    <img class="scroll-page-image img-fluid" src="/public/uploads/<%= comic_Field.savedFolder %>/<%- comicImage.split('/').map(encodeURIComponent).join('/') %>" loading="lazy" decoding="async" fetchpriority="low" alt="Page <%= index + 1 %>">
                </div>
            <% }) %>
        </div>
        <div id="infoComic" class="d-flex">
            <div class="px-3 align-self-center">
                <b style="border-bottom: 1px solid white;color:white;"><%=comic_Field.title%></b>
                <p >
                    <%=comic_Field.description%>
                </p>
                <p class="justify-text" style="font-size: 12px;">
                    Author:<br><% if(comic_Field.author != ""){ %>
                                <%=comic_Field.author%>
                                <% }else{ %>
                                    Unknown
                                <% }%>
                </p>
            </div>
            <div id="closeInfoComic" style="cursor: pointer;font-size: 25px;opacity: 0.5;">
                <i class="mx-2 fas fa-times"></i>
            </div>
        </div>
    </body>
<script src="/public/script/viewComic.js?v=20261115c"></script>
</html>