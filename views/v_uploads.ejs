<%- include("header") %>
<%
    var jobList = Array.isArray(typeof jobs !== 'undefined' ? jobs : null) ? jobs : [];
    var flashText = (typeof msg != 'undefined' && msg) ? String(msg) : '';
    var flashIsError = /error|fail|unable|could not|denied|not found|invalid/i.test(flashText);
    var STATUS_LABELS = { pending: 'Queued', processing: 'Processing', completed: 'Done', failed: 'Failed' };
    var nowMs = Date.now();
    function toIso(value) {
        var d = value ? new Date(value) : null;
        return d && !isNaN(d.getTime()) ? d.toISOString() : '';
    }
    // Server-side relative time (timezone independent); the inline script keeps it fresh.
    function relTime(value) {
        var d = value ? new Date(value) : null;
        if (!d || isNaN(d.getTime())) return '';
        var s = Math.round((nowMs - d.getTime()) / 1000);
        if (s < 45) return 'just now';
        var m = Math.round(s / 60);
        if (m < 60) return m + ' min ago';
        var h = Math.round(m / 60);
        if (h < 24) return h + (h === 1 ? ' hour ago' : ' hours ago');
        var days = Math.round(h / 24);
        if (days < 30) return days === 1 ? 'yesterday' : days + ' days ago';
        return d.toISOString().slice(0, 10);
    }
    function extOf(job) {
        var e = String(job.extension || '').replace(/^\./, '').toLowerCase();
        if (!e) {
            var parts = String(job.fileName || '').toLowerCase().split('.');
            e = parts.length > 1 ? parts.pop() : '';
        }
        return e;
    }
    // Comics created from this upload (several when the archive was a bundle); missing on older jobs.
    function comicsOf(job) {
        return Array.isArray(job.comics) ? job.comics.filter(function (c) { return c && c.id; }) : [];
    }
    var activeCount = jobList.filter(function (j) { return j.status === 'pending' || j.status === 'processing'; }).length;
%>
<style>
:where(.cr-card) {
    background: var(--cr-surface, #1b1b1f);
    border: 1px solid var(--cr-border, #34343b);
    border-radius: var(--cr-radius, 14px);
    box-shadow: var(--cr-shadow, 0 10px 30px rgba(0, 0, 0, .45));
    padding: 1.5rem;
}
:where(.cr-page-title) { font-weight: 700; letter-spacing: -.01em; }
:where(.cr-empty-state) { text-align: center; padding: 2rem 1.25rem; color: var(--cr-muted, #a6a6b0); }
.ul-page [hidden] { display: none !important; }
.ul-head .btn[hidden] { display: none !important; }

.ul-page {
    max-width: 760px;
    text-align: left;
    color: var(--cr-text, #ededf0);
    font-family: var(--cr-font, inherit);
}
.ul-muted { color: var(--cr-muted, #a6a6b0); }
.ul-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: .75rem 1rem; margin-bottom: 1.25rem; }
.ul-head p { margin: .25rem 0 0; }

.ul-page .btn { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border-radius: var(--cr-radius-sm, 8px); font-weight: 600; }
.ul-page .btn-accent {
    background: var(--cr-accent, #f5a524);
    border-color: var(--cr-accent, #f5a524);
    color: var(--cr-accent-contrast, #1a1204);
}
.ul-page .btn-accent:hover { filter: brightness(1.08); color: var(--cr-accent-contrast, #1a1204); }
.ul-page .btn-quiet {
    background: var(--cr-surface-2, #26262b);
    border: 1px solid var(--cr-border, #34343b);
    color: var(--cr-text, #ededf0);
}
.ul-page .btn-quiet:hover { border-color: var(--cr-muted, #a6a6b0); color: var(--cr-text, #ededf0); }
.ul-page .btn-dismiss { width: 44px; padding: 0; flex: 0 0 44px; }
.ul-page .btn-dismiss:hover { color: var(--cr-danger, #f87171); border-color: var(--cr-danger, #f87171); }
.ul-page .btn:focus-visible, .ul-page a:focus-visible { outline: 3px solid var(--cr-accent, #f5a524); outline-offset: 2px; box-shadow: none; }

.ul-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .75rem; }
.ul-job.cr-card { padding: 1rem; transition: opacity .2s ease, transform .2s ease; }
.ul-job.is-leaving { opacity: 0; transform: translateX(16px); }
.ul-job-top { display: flex; gap: .75rem; align-items: flex-start; }
.ul-job-icon {
    flex: 0 0 40px; height: 40px; border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--cr-surface-2, #26262b); color: var(--cr-accent, #f5a524); font-size: 1.1rem;
}
.ul-job-main { flex: 1; min-width: 0; }
.ul-job-name { font-weight: 600; margin: 0; font-size: 1rem; line-height: 1.35; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ul-job-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .5rem; margin-top: .2rem; font-size: .85rem; color: var(--cr-muted, #a6a6b0); }
.ul-chip {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .72rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    padding: .15rem .55rem; border-radius: 999px; line-height: 1.4;
    border: 1px solid var(--cr-border, #34343b); color: var(--cr-muted, #a6a6b0); white-space: nowrap;
}
.ul-status { flex: 0 0 auto; font-size: .75rem; padding: .25rem .6rem; }
.ul-status.is-pending { color: var(--cr-text, #ededf0); }
.ul-status.is-processing { color: var(--cr-accent, #f5a524); border-color: color-mix(in srgb, var(--cr-accent, #f5a524) 55%, transparent); background: var(--cr-accent-soft, rgba(245, 165, 36, .14)); }
.ul-status.is-completed { color: var(--cr-success, #4ade80); border-color: color-mix(in srgb, var(--cr-success, #4ade80) 50%, transparent); background: color-mix(in srgb, var(--cr-success, #4ade80) 12%, transparent); }
.ul-status.is-failed { color: var(--cr-danger, #f87171); border-color: color-mix(in srgb, var(--cr-danger, #f87171) 55%, transparent); background: color-mix(in srgb, var(--cr-danger, #f87171) 12%, transparent); }
.ul-dot { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
.is-processing .ul-dot, .is-pending .ul-dot { animation: ul-pulse 1.4s ease-in-out infinite; }
@keyframes ul-pulse { 50% { opacity: .3; } }

.ul-progress { margin-top: .85rem; }
.ul-progress-row { display: flex; justify-content: space-between; font-size: .8rem; color: var(--cr-muted, #a6a6b0); margin-bottom: .3rem; font-variant-numeric: tabular-nums; }
.ul-bar { height: 8px; border-radius: 999px; background: var(--cr-surface-2, #26262b); overflow: hidden; }
.ul-bar > span { display: block; height: 100%; width: 0; background: var(--cr-accent, #f5a524); border-radius: inherit; transition: width .4s ease; }
.ul-error {
    margin: .75rem 0 0; padding: .55rem .75rem; font-size: .875rem; border-radius: var(--cr-radius-sm, 8px);
    color: var(--cr-text, #ededf0); background: color-mix(in srgb, var(--cr-danger, #f87171) 12%, transparent);
    border-left: 3px solid var(--cr-danger, #f87171); overflow-wrap: anywhere;
}
.ul-note { margin: .6rem 0 0; font-size: .85rem; }
.ul-bundle { margin-top: .75rem; }
.ul-bundle .ul-note { margin: 0 0 .35rem; display: flex; align-items: center; gap: .4rem; }
.ul-bundle-list { list-style: none; margin: 0; padding: 0; border: 1px solid var(--cr-border, #34343b); border-radius: var(--cr-radius-sm, 8px); overflow: hidden; }
.ul-bundle-list li + li { border-top: 1px solid var(--cr-border, #34343b); }
.ul-bundle-link {
    display: flex; align-items: center; gap: .5rem; min-height: 44px; padding: .4rem .75rem;
    background: var(--cr-surface-2, #26262b); color: var(--cr-text, #ededf0); font-size: .9rem; font-weight: 600;
    text-decoration: none; overflow-wrap: anywhere;
}
.ul-bundle-link:hover { color: var(--cr-accent, #f5a524); }
.ul-bundle-link > i { flex: 0 0 auto; color: var(--cr-muted, #a6a6b0); }
.ul-bundle-link > span { min-width: 0; }
.ul-sending { margin-bottom: 1.5rem; }
.ul-section-title { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--cr-muted, #a6a6b0); margin: 0 0 .6rem; }
.ul-status.is-sending { color: var(--cr-accent, #f5a524); border-color: color-mix(in srgb, var(--cr-accent, #f5a524) 55%, transparent); background: var(--cr-accent-soft, rgba(245, 165, 36, .14)); }
.ul-status.is-paused { color: var(--cr-text, #ededf0); }
.is-sending .ul-dot { animation: ul-pulse 1.4s ease-in-out infinite; }
.ul-actions { display: flex; gap: .5rem; margin-top: .85rem; }
.ul-actions .btn:not(.btn-dismiss) { flex: 1 1 0; min-width: 0; white-space: nowrap; padding-left: .6rem; padding-right: .6rem; }
@media (max-width: 399.98px) {
    /* Keep "Open" + "Edit details" + dismiss on one line on the narrowest phones */
    .ul-actions .btn:not(.btn-dismiss):not(:only-child) > i { display: none; }
}

.ul-alert { border-radius: var(--cr-radius-sm, 8px); }
.ul-empty .cr-empty-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 72px; height: 72px; margin-bottom: 1rem; border-radius: 50%;
    background: var(--cr-surface-2, #26262b); color: var(--cr-accent, #f5a524); font-size: 1.75rem;
}
.ul-empty h2 { color: var(--cr-text, #ededf0); font-size: 1.3rem; font-weight: 700; }
.ul-live-note { font-size: .8rem; margin-top: 1rem; text-align: center; }

@media (max-width: 575.98px) {
    .ul-head .btn { width: 100%; min-height: 48px; font-size: 1.05rem; }
    .ul-head > div { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
    .ul-job.cr-card, .ul-bar > span { transition: none; }
    .is-processing .ul-dot, .is-pending .ul-dot { animation: none; }
}
</style>

<div class="container content_c mt-4 mb-5 ul-page" id="uploadsPage">
    <div class="ul-head">
        <div>
            <h1 class="cr-page-title h3 mb-0">Uploads</h1>
            <p class="ul-muted">Files you sent to ComicRoom and how processing went.</p>
        </div>
        <a class="btn btn-accent px-4" id="headUploadButton" href="/comic/upload" <%= jobList.length ? '' : 'hidden' %>><i class="fas fa-file-upload" aria-hidden="true"></i> Upload a comic</a>
    </div>

    <% if (flashText) { %>
    <div class="alert <%= flashIsError ? 'alert-danger' : 'alert-info' %> ul-alert" role="<%= flashIsError ? 'alert' : 'status' %>"><%= flashText %></div>
    <% } %>

    <div id="dismissError" class="alert alert-danger ul-alert" role="alert" hidden></div>

    <!-- Files this browser is still sending (filled by public/script/uploadManager.js events) -->
    <section id="sendingSection" class="ul-sending" aria-labelledby="sendingHeading" hidden>
        <h2 class="ul-section-title" id="sendingHeading">Sending from this device</h2>
        <ul class="ul-list" id="sendingList"></ul>
        <p class="ul-note ul-muted">You can keep using ComicRoom while this runs. It shows up below once the server has the whole file.</p>
    </section>

    <ul class="ul-list" id="jobList" aria-label="Your uploads" <%= jobList.length ? '' : 'hidden' %>>
        <% jobList.forEach(function (job) {
            var status = STATUS_LABELS[job.status] ? job.status : 'pending';
            var active = status === 'pending' || status === 'processing';
            var progress = status === 'completed' ? 100 : Math.max(0, Math.min(100, Math.round(Number(job.progress) || 0)));
            var ext = extOf(job);
            var iso = toIso(job.createdAt);
            var jobComics = comicsOf(job);
            var comic = job.comic || jobComics[0] || null;
            var nameId = 'job-name-' + String(job.jobId).replace(/[^A-Za-z0-9_-]/g, '');
        %>
        <li class="ul-job cr-card" data-job-id="<%= job.jobId %>" data-status="<%= status %>" data-progress="<%= progress %>" aria-labelledby="<%= nameId %>">
            <div class="ul-job-top">
                <span class="ul-job-icon" aria-hidden="true"><i class="fas <%= ext === 'pdf' ? 'fa-file-pdf' : 'fa-file-archive' %>"></i></span>
                <div class="ul-job-main">
                    <h2 class="ul-job-name" id="<%= nameId %>" title="<%= job.fileName %>"><%= job.fileName || 'Untitled file' %></h2>
                    <div class="ul-job-meta">
                        <% if (ext) { %><span class="ul-chip"><%= ext %></span><% } %>
                        <% if (iso) { %><time datetime="<%= iso %>" class="ul-time"><%= relTime(job.createdAt) %></time><% } %>
                    </div>
                </div>
                <span class="ul-chip ul-status is-<%= status %>"><span class="ul-dot" aria-hidden="true"></span><span class="visually-hidden">Status: </span><%= STATUS_LABELS[status] %></span>
            </div>
            <% if (active) { %>
            <div class="ul-progress">
                <div class="ul-progress-row"><span><%= status === 'pending' ? 'Waiting to start' : (progress >= 85 ? 'Reading details and saving' : 'Extracting pages') %></span><span class="ul-pct"><%= progress %>%</span></div>
                <div class="ul-bar" role="progressbar" aria-label="Processing <%= job.fileName %>" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress %>"><span style="width: <%= progress %>%"></span></div>
            </div>
            <% } %>
            <% if (status === 'failed') { %>
            <p class="ul-error"><%= job.errorMessage || 'The file could not be processed. It may be damaged or in an unsupported format.' %></p>
            <% } %>
            <% if (status === 'completed' && !comic) { %>
            <p class="ul-note ul-muted">This comic is no longer in your library.</p>
            <% } %>
            <% if (status === 'completed' && jobComics.length > 1) { %>
            <div class="ul-bundle">
                <p class="ul-note ul-muted"><i class="fas fa-layer-group" aria-hidden="true"></i> <%= jobComics.length %> comics from this archive</p>
                <ul class="ul-bundle-list" aria-label="Comics from <%= job.fileName || 'this archive' %>">
                    <% jobComics.forEach(function (c) { %>
                    <li><a class="ul-bundle-link" href="/comic/show/<%= encodeURIComponent(String(c.id)) %>"><i class="fas fa-book-open" aria-hidden="true"></i><span><span class="visually-hidden">Open </span><%= c.title || 'Untitled comic' %></span></a></li>
                    <% }); %>
                </ul>
            </div>
            <% } %>
            <div class="ul-actions">
                <% if (status === 'completed' && comic) { %>
                    <a class="btn btn-accent" href="/comic/show/<%= comic.id %>"><i class="fas fa-book-open" aria-hidden="true"></i> Open</a>
                    <a class="btn btn-quiet" href="/comic/<%= encodeURIComponent(comic.savedFolder) %>/<%= comic.id %>"><i class="fas fa-pen" aria-hidden="true"></i> Edit details</a>
                <% } else if (active) { %>
                    <a class="btn btn-quiet" href="/comic/status/<%= encodeURIComponent(job.jobId) %>"><i class="fas fa-tasks" aria-hidden="true"></i> View status</a>
                <% } else if (status === 'failed') { %>
                    <a class="btn btn-accent" href="/comic/upload"><i class="fas fa-redo" aria-hidden="true"></i> Upload again</a>
                <% } %>
                <% if (!active) { %>
                    <button type="button" class="btn btn-quiet btn-dismiss js-dismiss" aria-label="Dismiss <%= job.fileName %>" title="Dismiss"><i class="fas fa-times" aria-hidden="true"></i></button>
                <% } %>
            </div>
        </li>
        <% }); %>
    </ul>

    <div class="cr-empty-state ul-empty" id="emptyState" <%= jobList.length ? 'hidden' : '' %>>
        <span class="cr-empty-icon" aria-hidden="true"><i class="fas fa-inbox"></i></span>
        <h2>No uploads yet</h2>
        <p>Upload a CBZ, CBR, ZIP, RAR or PDF file. It shows up here while it is processed.</p>
        <div class="cr-empty-actions">
            <a class="btn btn-accent px-4" href="/comic/upload"><i class="fas fa-file-upload" aria-hidden="true"></i> Upload a comic</a>
        </div>
    </div>

    <p class="ul-live-note ul-muted" id="pollNote" <%= activeCount ? '' : 'hidden' %>>This list updates automatically while files are processing.</p>
    <p class="visually-hidden" id="liveRegion" role="status" aria-live="polite"></p>
</div>

<script>
(function () {
    var list = document.getElementById('jobList');
    var sendingSection = document.getElementById('sendingSection');
    var sendingList = document.getElementById('sendingList');
    var emptyState = document.getElementById('emptyState');
    var pollNote = document.getElementById('pollNote');
    var liveRegion = document.getElementById('liveRegion');
    var dismissError = document.getElementById('dismissError');
    var LABELS = { pending: 'Queued', processing: 'Processing', completed: 'Done', failed: 'Failed' };

    var MIN_DELAY = 2500;
    var MAX_DELAY = 15000;
    var MAX_ERROR_DELAY = 60000;
    var delay = MIN_DELAY;
    var errorCount = 0;
    var timer = null;
    var inFlight = false;
    var dismissing = {}; // jobId -> true while a dismiss request is pending

    // ---------- helpers ----------
    function cards() { return Array.prototype.slice.call(list.querySelectorAll('.ul-job')); }
    function findCard(jobId) {
        for (var i = 0, all = cards(); i < all.length; i++) if (all[i].getAttribute('data-job-id') === String(jobId)) return all[i];
        return null;
    }
    function isActiveStatus(s) { return s === 'pending' || s === 'processing'; }
    function hasActive() { return cards().some(function (c) { return isActiveStatus(c.getAttribute('data-status')); }); }
    function announce(text) { liveRegion.textContent = ''; setTimeout(function () { liveRegion.textContent = text; }, 50); }
    function el(tag, className, text) {
        var node = document.createElement(tag);
        if (className) node.className = className;
        if (text != null) node.textContent = text;
        return node;
    }
    function icon(name) { var i = el('i', 'fas ' + name); i.setAttribute('aria-hidden', 'true'); return i; }
    function extOf(job) {
        var e = String(job.extension || '').replace(/^\./, '').toLowerCase();
        if (!e) { var p = String(job.fileName || '').toLowerCase().split('.'); e = p.length > 1 ? p.pop() : ''; }
        return e;
    }
    var rtf = (window.Intl && Intl.RelativeTimeFormat) ? new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' }) : null;
    function relTime(iso) {
        var t = new Date(iso).getTime();
        if (!isFinite(t)) return '';
        var s = Math.round((t - Date.now()) / 1000);
        var a = Math.abs(s);
        if (a < 45) return 'just now';
        if (!rtf) return new Date(t).toLocaleString();
        if (a < 3600) return rtf.format(Math.round(s / 60), 'minute');
        if (a < 86400) return rtf.format(Math.round(s / 3600), 'hour');
        if (a < 86400 * 30) return rtf.format(Math.round(s / 86400), 'day');
        return new Date(t).toLocaleDateString();
    }
    function refreshTimes() {
        Array.prototype.forEach.call(list.querySelectorAll('time.ul-time'), function (t) {
            var text = relTime(t.getAttribute('datetime'));
            if (text) t.textContent = text;
            t.title = new Date(t.getAttribute('datetime')).toLocaleString();
        });
    }
    function stageText(status, progress) {
        if (status === 'pending') return 'Waiting to start';
        return progress >= 85 ? 'Reading details and saving' : 'Extracting pages';
    }

    // ---------- card rendering (mirrors the server template) ----------
    function buildCard(job) {
        var status = LABELS[job.status] ? job.status : 'pending';
        var active = isActiveStatus(status);
        var progress = status === 'completed' ? 100 : Math.max(0, Math.min(100, Math.round(Number(job.progress) || 0)));
        var ext = extOf(job);
        var jobComics = Array.isArray(job.comics) ? job.comics.filter(function (c) { return c && c.id; }) : [];
        var comic = job.comic || jobComics[0] || null;
        var name = job.fileName || 'Untitled file';
        var nameId = 'job-name-' + String(job.jobId).replace(/[^A-Za-z0-9_-]/g, '');

        var li = el('li', 'ul-job cr-card');
        li.setAttribute('data-job-id', job.jobId);
        li.setAttribute('data-status', status);
        li.setAttribute('data-progress', String(progress));
        li.setAttribute('aria-labelledby', nameId);

        var top = el('div', 'ul-job-top');
        var ic = el('span', 'ul-job-icon'); ic.setAttribute('aria-hidden', 'true');
        ic.appendChild(icon(ext === 'pdf' ? 'fa-file-pdf' : 'fa-file-archive'));
        var main = el('div', 'ul-job-main');
        var h = el('h2', 'ul-job-name', name); h.id = nameId; h.title = job.fileName || '';
        var meta = el('div', 'ul-job-meta');
        if (ext) meta.appendChild(el('span', 'ul-chip', ext));
        var created = job.createdAt ? new Date(job.createdAt) : null;
        if (created && !isNaN(created.getTime())) {
            var t = el('time', 'ul-time'); t.setAttribute('datetime', created.toISOString());
            meta.appendChild(t);
        }
        main.appendChild(h); main.appendChild(meta);
        var chip = el('span', 'ul-chip ul-status is-' + status);
        var dot = el('span', 'ul-dot'); dot.setAttribute('aria-hidden', 'true');
        chip.appendChild(dot); chip.appendChild(el('span', 'visually-hidden', 'Status: ')); chip.appendChild(document.createTextNode(LABELS[status]));
        top.appendChild(ic); top.appendChild(main); top.appendChild(chip);
        li.appendChild(top);

        if (active) {
            var pr = el('div', 'ul-progress');
            var row = el('div', 'ul-progress-row');
            row.appendChild(el('span', null, stageText(status, progress)));
            row.appendChild(el('span', 'ul-pct', progress + '%'));
            var bar = el('div', 'ul-bar');
            bar.setAttribute('role', 'progressbar');
            bar.setAttribute('aria-label', 'Processing ' + (job.fileName || ''));
            bar.setAttribute('aria-valuemin', '0'); bar.setAttribute('aria-valuemax', '100'); bar.setAttribute('aria-valuenow', String(progress));
            var fill = el('span'); fill.style.width = progress + '%';
            bar.appendChild(fill); pr.appendChild(row); pr.appendChild(bar);
            li.appendChild(pr);
        }
        if (status === 'failed') li.appendChild(el('p', 'ul-error', job.errorMessage || 'The file could not be processed. It may be damaged or in an unsupported format.'));
        if (status === 'completed' && !comic) li.appendChild(el('p', 'ul-note ul-muted', 'This comic is no longer in your library.'));
        if (status === 'completed' && jobComics.length > 1) {
            var bundle = el('div', 'ul-bundle');
            var note = el('p', 'ul-note ul-muted');
            note.appendChild(icon('fa-layer-group'));
            note.appendChild(document.createTextNode(' ' + jobComics.length + ' comics from this archive'));
            var ul = el('ul', 'ul-bundle-list');
            ul.setAttribute('aria-label', 'Comics from ' + (job.fileName || 'this archive'));
            jobComics.forEach(function (c) {
                var item = el('li');
                var a = el('a', 'ul-bundle-link');
                a.href = '/comic/show/' + encodeURIComponent(c.id);
                a.appendChild(icon('fa-book-open'));
                var label = el('span');
                label.appendChild(el('span', 'visually-hidden', 'Open '));
                label.appendChild(document.createTextNode(c.title || 'Untitled comic'));
                a.appendChild(label);
                item.appendChild(a);
                ul.appendChild(item);
            });
            bundle.appendChild(note); bundle.appendChild(ul);
            li.appendChild(bundle);
        }

        var actions = el('div', 'ul-actions');
        function link(cls, href, iconName, text) {
            var a = el('a', 'btn ' + cls); a.href = href; a.appendChild(icon(iconName)); a.appendChild(document.createTextNode(' ' + text));
            actions.appendChild(a);
        }
        if (status === 'completed' && comic) {
            link('btn-accent', '/comic/show/' + encodeURIComponent(comic.id), 'fa-book-open', 'Open');
            link('btn-quiet', '/comic/' + encodeURIComponent(comic.savedFolder) + '/' + encodeURIComponent(comic.id), 'fa-pen', 'Edit details');
        } else if (active) {
            link('btn-quiet', '/comic/status/' + encodeURIComponent(job.jobId), 'fa-tasks', 'View status');
        } else if (status === 'failed') {
            link('btn-accent', '/comic/upload', 'fa-redo', 'Upload again');
        }
        if (!active) {
            var b = el('button', 'btn btn-quiet btn-dismiss js-dismiss'); b.type = 'button';
            b.setAttribute('aria-label', 'Dismiss ' + (job.fileName || ''));
            b.title = 'Dismiss';
            b.appendChild(icon('fa-times'));
            actions.appendChild(b);
        }
        li.appendChild(actions);
        return li;
    }

    function updateProgressOnly(card, job) {
        var progress = Math.max(0, Math.min(100, Math.round(Number(job.progress) || 0)));
        card.setAttribute('data-progress', String(progress));
        var fill = card.querySelector('.ul-bar > span');
        var bar = card.querySelector('.ul-bar');
        var pct = card.querySelector('.ul-pct');
        var stage = card.querySelector('.ul-progress-row > span');
        if (fill) fill.style.width = progress + '%';
        if (bar) bar.setAttribute('aria-valuenow', String(progress));
        if (pct) pct.textContent = progress + '%';
        if (stage) stage.textContent = stageText(job.status, progress);
    }

    function syncEmpty() {
        var count = cards().length;
        var sending = sendingList.children.length;
        list.hidden = count === 0;
        emptyState.hidden = count !== 0 || sending !== 0;
        document.getElementById('headUploadButton').hidden = count === 0 && sending === 0;
        pollNote.hidden = !hasActive();
    }

    // Apply the server's list (newest first). Returns true when anything changed.
    function applyJobs(jobs) {
        var changed = false;
        var seen = {};
        var focusedCard = document.activeElement && document.activeElement.closest ? document.activeElement.closest('.ul-job') : null;
        var focusedId = focusedCard ? focusedCard.getAttribute('data-job-id') : null;

        jobs.forEach(function (job, index) {
            if (!job || job.jobId == null || dismissing[job.jobId]) return;
            var id = String(job.jobId);
            seen[id] = true;
            var card = findCard(id);
            var status = LABELS[job.status] ? job.status : 'pending';
            if (!card) {
                card = buildCard(job);
                // Insert before the first card that comes later in the server order
                var nextCard = null;
                for (var j = index + 1; j < jobs.length && !nextCard; j++) nextCard = findCard(jobs[j] && jobs[j].jobId);
                list.insertBefore(card, nextCard || null);
                changed = true;
                return;
            }
            var oldStatus = card.getAttribute('data-status');
            if (oldStatus !== status) {
                var fresh = buildCard(job);
                card.parentNode.replaceChild(fresh, card);
                changed = true;
                var readyCount = Array.isArray(job.comics) ? job.comics.length : 0;
                if (status === 'completed') announce((job.fileName || 'Your comic') + (readyCount > 1 ? ' is ready: ' + readyCount + ' comics added.' : ' is ready.'));
                else if (status === 'failed') announce((job.fileName || 'An upload') + ' failed to process.');
                if (focusedId === id) {
                    var target = fresh.querySelector('.ul-actions .btn');
                    if (target) target.focus();
                }
            } else if (isActiveStatus(status) && String(Math.round(Number(job.progress) || 0)) !== card.getAttribute('data-progress')) {
                updateProgressOnly(card, job);
                changed = true;
            }
        });

        // Jobs the server no longer lists (dismissed elsewhere)
        cards().forEach(function (card) {
            if (!seen[card.getAttribute('data-job-id')] && !dismissing[card.getAttribute('data-job-id')]) {
                card.parentNode.removeChild(card);
                changed = true;
            }
        });
        refreshTimes();
        syncEmpty();
        return changed;
    }

    // ---------- files still being sent from this browser ----------
    function formatBytes(bytes) {
        var units = ['B', 'KB', 'MB', 'GB'];
        var i = 0, v = bytes || 0;
        while (v >= 1024 && i < units.length - 1) { v /= 1024; i++; }
        return v.toFixed(i === 0 ? 0 : (v < 10 ? 1 : 0)) + ' ' + units[i];
    }
    var SENDING_LABELS = { queued: 'Sending', sending: 'Sending', waiting: 'Offline', error: 'Paused', 'needs-file': 'Paused', login: 'Paused' };
    function sendingCard(u) {
        var li = el('li', 'ul-job cr-card');
        li.setAttribute('data-upload-id', u.id);
        var top = el('div', 'ul-job-top');
        var ic = el('span', 'ul-job-icon'); ic.setAttribute('aria-hidden', 'true');
        ic.appendChild(icon(/\.pdf$/i.test(u.name) ? 'fa-file-pdf' : 'fa-file-archive'));
        top.appendChild(ic);
        var main = el('div', 'ul-job-main');
        var name = el('h3', 'ul-job-name', u.name); name.title = u.name;
        main.appendChild(name);
        var meta = el('div', 'ul-job-meta');
        var ext = String(u.name).toLowerCase().split('.').pop();
        if (ext && ext !== u.name.toLowerCase()) meta.appendChild(el('span', 'ul-chip', ext));
        meta.appendChild(el('span', 'ul-sent', formatBytes(u.sent) + ' of ' + formatBytes(u.size)));
        main.appendChild(meta);
        top.appendChild(main);
        var active = u.state === 'queued' || u.state === 'sending' || u.state === 'waiting';
        var chip = el('span', 'ul-chip ul-status ' + (active ? 'is-sending' : 'is-paused'));
        var dot = el('span', 'ul-dot'); dot.setAttribute('aria-hidden', 'true');
        chip.appendChild(dot);
        chip.appendChild(document.createTextNode(SENDING_LABELS[u.state] || 'Sending'));
        top.appendChild(chip);
        li.appendChild(top);

        var percent = u.size ? Math.floor((u.sent / u.size) * 100) : 0;
        var pr = el('div', 'ul-progress');
        var row = el('div', 'ul-progress-row');
        row.appendChild(el('span', null, u.state === 'waiting' ? 'Waiting for a connection' : (active ? (u.sent >= u.size ? 'Finishing on the server' : 'Sending the file') : 'Stopped')));
        row.appendChild(el('span', 'ul-pct', percent + '%'));
        pr.appendChild(row);
        var bar = el('div', 'ul-bar');
        bar.setAttribute('role', 'progressbar');
        bar.setAttribute('aria-label', 'Sending ' + u.name);
        bar.setAttribute('aria-valuemin', '0'); bar.setAttribute('aria-valuemax', '100'); bar.setAttribute('aria-valuenow', String(percent));
        var fill = el('span'); fill.style.width = percent + '%';
        bar.appendChild(fill);
        pr.appendChild(bar);
        li.appendChild(pr);

        if (!active) {
            var why = u.state === 'needs-file'
                ? 'The browser no longer has access to this file. Choose the same file again on the Upload page to continue from ' + percent + '%.'
                : (u.error || 'The upload stopped.');
            li.appendChild(el('p', 'ul-error', why));
        }
        var actions = el('div', 'ul-actions');
        if (u.state === 'needs-file') {
            var pick = el('a', 'btn btn-accent'); pick.href = '/comic/upload';
            pick.appendChild(icon('fa-folder-open')); pick.appendChild(document.createTextNode(' Choose file'));
            actions.appendChild(pick);
        } else if (!active) {
            var resume = el('button', 'btn btn-accent'); resume.type = 'button';
            resume.appendChild(icon('fa-redo')); resume.appendChild(document.createTextNode(' Resume'));
            resume.addEventListener('click', function () { window.CRUploads.resume(u.id); });
            actions.appendChild(resume);
        }
        var cancel = el('button', 'btn btn-quiet'); cancel.type = 'button';
        cancel.appendChild(icon('fa-times')); cancel.appendChild(document.createTextNode(' Cancel'));
        cancel.setAttribute('aria-label', 'Cancel sending ' + u.name);
        cancel.addEventListener('click', function () {
            if (window.confirm('Stop sending "' + u.name + '"? The parts sent so far are deleted.')) window.CRUploads.cancel(u.id);
        });
        actions.appendChild(cancel);
        li.appendChild(actions);
        return li;
    }
    var lastSendingKey = '';
    function renderSending(uploads) {
        var pending = (uploads || []).filter(function (u) { return u.state !== 'done'; });
        // Rebuild only when something visible changed (keeps button focus stable)
        var key = pending.map(function (u) { return u.id + ':' + u.state + ':' + Math.floor((u.sent / (u.size || 1)) * 100) + ':' + (u.error || ''); }).join('|');
        if (key === lastSendingKey) return;
        var focusedId = document.activeElement && document.activeElement.closest && document.activeElement.closest('[data-upload-id]');
        focusedId = focusedId ? focusedId.getAttribute('data-upload-id') : null;
        lastSendingKey = key;
        sendingList.textContent = '';
        pending.forEach(function (u) { sendingList.appendChild(sendingCard(u)); });
        sendingSection.hidden = pending.length === 0;
        if (focusedId) {
            var again = sendingList.querySelector('[data-upload-id="' + focusedId + '"] .btn');
            if (again) again.focus();
        }
        syncEmpty();
    }
    document.addEventListener('cr:upload-progress', function (event) {
        renderSending(event.detail && event.detail.uploads);
    });
    // Sent: the server now has a job for it, so fetch the list right away
    document.addEventListener('cr:upload-done', function () {
        delay = MIN_DELAY;
        setTimeout(poll, 300);
    });
    if (window.CRUploads) renderSending(window.CRUploads.list());

    // ---------- polling ----------
    function stop() {
        if (timer) clearTimeout(timer);
        timer = null;
    }
    function schedule(ms) {
        stop();
        if (document.visibilityState === 'hidden') return; // resumed by visibilitychange
        timer = setTimeout(poll, ms);
    }
    function poll() {
        timer = null;
        if (inFlight || document.visibilityState === 'hidden') return;
        inFlight = true;
        fetch('/ajax/upload/recent', { cache: 'no-store', credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
            .then(function (res) {
                if (res.status === 401 || res.status === 403) { var e = new Error('auth'); e.fatal = true; throw e; }
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(function (data) {
                inFlight = false;
                errorCount = 0;
                var jobs = Array.isArray(data) ? data : (data && Array.isArray(data.jobs) ? data.jobs : []);
                var changed = applyJobs(jobs);
                if (!hasActive()) { stop(); return; }
                delay = changed ? MIN_DELAY : Math.min(Math.round(delay * 1.5), MAX_DELAY);
                schedule(delay);
            })
            .catch(function (err) {
                inFlight = false;
                if (err && err.fatal) { stop(); return; }
                errorCount++;
                schedule(Math.min(MIN_DELAY * Math.pow(2, errorCount), MAX_ERROR_DELAY));
            });
    }

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') { stop(); return; }
        refreshTimes();
        delay = MIN_DELAY;
        // One refresh on return also picks up uploads started in another tab
        if (!inFlight) schedule(0);
    });

    // ---------- dismiss ----------
    function showDismissError(text) {
        dismissError.textContent = text;
        dismissError.hidden = false;
    }

    list.addEventListener('click', function (event) {
        var button = event.target.closest ? event.target.closest('.js-dismiss') : null;
        if (!button) return;
        var card = button.closest('.ul-job');
        if (!card) return;
        var id = card.getAttribute('data-job-id');
        var status = card.getAttribute('data-status');
        var name = (card.querySelector('.ul-job-name') || {}).textContent || 'this upload';
        if (status === 'failed' && !window.confirm('Dismiss "' + name + '"? The error details will no longer be shown.')) return;

        dismissError.hidden = true;
        dismissing[id] = true;
        var parent = card.parentNode;
        var nextSibling = card.nextSibling;
        var all = cards();
        var idx = all.indexOf(card);
        var focusTarget = all[idx + 1] || all[idx - 1] || null;

        // Optimistic removal
        card.classList.add('is-leaving');
        var removeNow = function () {
            if (card.parentNode) card.parentNode.removeChild(card);
            syncEmpty();
            var next = focusTarget && focusTarget.parentNode ? focusTarget.querySelector('.ul-actions .btn') : null;
            if (next) next.focus();
            else (cards().length ? document.getElementById('headUploadButton') : emptyState.querySelector('.btn')).focus();
        };
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var removeTimer = null;
        if (reduce) removeNow(); else removeTimer = setTimeout(removeNow, 200);
        announce('Dismissed ' + name + '.');

        fetch('/comic/uploads/' + encodeURIComponent(id) + '/dismiss', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Accept': 'application/json' }
        })
            .then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                    if (!res.ok || !data || data.error || data.ok === false) {
                        throw new Error((data && data.error) || (res.status === 401 ? 'Your session has expired. Log in again.' : 'Could not dismiss this upload (HTTP ' + res.status + ').'));
                    }
                });
            })
            .then(function () { delete dismissing[id]; })
            .catch(function (err) {
                delete dismissing[id];
                if (removeTimer) clearTimeout(removeTimer);
                // Put the card back where it was
                card.classList.remove('is-leaving');
                if (!card.parentNode) {
                    parent.insertBefore(card, nextSibling && nextSibling.parentNode === parent ? nextSibling : null);
                }
                syncEmpty();
                showDismissError(err.message || 'Could not dismiss this upload.');
                var b = card.querySelector('.js-dismiss');
                if (b) b.focus();
            });
    });

    // ---------- start ----------
    refreshTimes();
    setInterval(function () { if (document.visibilityState === 'visible') refreshTimes(); }, 60000);
    if (hasActive()) schedule(MIN_DELAY);
})();
</script>
<%- include("footer") %>
