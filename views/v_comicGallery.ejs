<%- include("header") %>
<%
  var keyword = (typeof searchKeywords !== 'undefined' && searchKeywords) ? searchKeywords : '';
  var list = Array.isArray(comics) ? comics : [];
  var signedIn = typeof userData != 'undefined' && userData != null;
  var EAGER_COUNT = 6; // first row on the widest grid
%>
<div id="content_body" class="container-xl cr-page">
  <div class="cr-page-head">
    <div>
      <% if (keyword) { %>
        <h1 class="cr-page-title">Search results</h1>
        <p class="cr-page-sub">Comics matching <strong class="text-white">&ldquo;<%= keyword %>&rdquo;</strong> &middot; <a href="/comic">Clear search</a></p>
      <% } else { %>
        <h1 class="cr-page-title">Gallery</h1>
        <p class="cr-page-sub">Latest uploads first.</p>
      <% } %>
    </div>
    <% if (signedIn) { %>
      <a class="btn cr-btn-accent" href="/comic/upload"><i class="fas fa-file-upload" aria-hidden="true"></i> Upload a comic</a>
    <% } %>
  </div>

  <% if (list.length === 0) { %>
    <div class="cr-empty-state">
      <span class="cr-empty-icon" aria-hidden="true"><i class="fas fa-book"></i></span>
      <h2>No comics yet</h2>
      <% if (signedIn) { %>
        <p>The gallery is empty. Upload a CBZ, CBR or PDF file to add the first comic.</p>
        <div class="cr-empty-actions">
          <a class="btn cr-btn-accent" href="/comic/upload"><i class="fas fa-file-upload" aria-hidden="true"></i> Upload a comic</a>
        </div>
      <% } else { %>
        <p>The gallery is empty. Sign in or create an account to upload the first comic.</p>
        <div class="cr-empty-actions">
          <a class="btn cr-btn-accent" href="/register">Sign up</a>
          <a class="btn cr-btn-ghost" href="/login">Log in</a>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <ul id="bodyComic" class="cr-grid" data-feed="comic" data-offset="<%= list.length %>" data-page-size="12" data-keyword="<%= keyword %>" aria-label="Comics">
      <% list.forEach(function (comic, i) { %>
        <li data-id="<%= comic.id %>">
          <a class="cr-comic-card" href="/comic/show/<%= encodeURIComponent(comic.id) %>">
            <div class="cr-cover">
              <img src="/comic/cover/<%= encodeURIComponent(comic.id) %>" alt="" width="400" height="600" decoding="async"<% if (i >= EAGER_COUNT) { %> loading="lazy"<% } else if (i === 0) { %> fetchpriority="high"<% } %>>
            </div>
            <div class="cr-comic-meta">
              <h2 class="cr-comic-title"><%= comic.title %></h2>
              <% if (comic.author) { %><p class="cr-comic-author"><%= comic.author %></p><% } %>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>

    <div class="cr-feed-footer">
      <div id="feedStatus" role="status" aria-live="polite"></div>
      <button id="loadMore" type="button" class="btn cr-btn-ghost"<% if (list.length < 12) { %> hidden<% } %>>Load more</button>
    </div>
    <div id="feedSentinel" class="cr-sentinel" aria-hidden="true"></div>
    <script src="/public/script/loadMoreComic.js?v=2" defer></script>
  <% } %>
</div>
<%- include("footer") %>
