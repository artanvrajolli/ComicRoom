<%- include("header") %>
<%
  var keyword = (typeof searchKeywords !== 'undefined' && searchKeywords) ? searchKeywords : '';
  var rows = (typeof data !== 'undefined' && Array.isArray(data)) ? data : [];
  var entries = rows.filter(function (d) { return d && d.comic; });
  var EAGER_COUNT = 6;
  // Flash message(s) from the controller: string or array, may be missing/empty
  var flashMessages = (typeof msg !== 'undefined' && msg != null ? (Array.isArray(msg) ? msg : [msg]) : [])
    .filter(function (m) { return m != null && String(m).trim() !== ''; })
    .map(String);
  // pageNumber is stored 0-based by the reader (viewComic.js persists its xView index)
  function progressOf(entry) {
    var total = parseInt(entry.comic.totalPages, 10) || 0;
    var current = (parseInt(entry.pageNumber, 10) || 0) + 1;
    if (current < 1) current = 1;
    if (total > 0 && current > total) current = total;
    var percent = total > 0 ? Math.round((current / total) * 100) : 0;
    return { current: current, total: total, percent: percent, done: total > 0 && current >= total };
  }
%>
<div id="content_body" class="container-xl cr-page">
  <% if (flashMessages.length) { %>
    <div class="cr-alert cr-alert-dismissible" role="status">
      <i class="fas fa-info-circle" aria-hidden="true"></i>
      <div class="cr-alert-body">
        <% if (flashMessages.length === 1) { %><%= flashMessages[0] %><% } else { %>
          <ul><% flashMessages.forEach(function (m) { %><li><%= m %></li><% }) %></ul>
        <% } %>
      </div>
      <button type="button" class="cr-icon-btn cr-alert-close" data-cr-dismiss aria-label="Dismiss message"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
  <% } %>

  <div class="cr-page-head">
    <div>
      <h1 class="cr-page-title">Continue reading</h1>
      <% if (keyword) { %>
        <p class="cr-page-sub">In your reading list, matching <strong class="text-white">&ldquo;<%= keyword %>&rdquo;</strong></p>
      <% } else { %>
        <p class="cr-page-sub">Comics you have started, most recent first.</p>
      <% } %>
    </div>
    <% if (keyword) { %>
      <a class="btn cr-btn-ghost" href="/onread"><i class="fas fa-times" aria-hidden="true"></i> Clear search</a>
    <% } %>
  </div>

  <% if (entries.length === 0) { %>
    <div class="cr-empty-state">
      <span class="cr-empty-icon" aria-hidden="true"><i class="fas fa-book-open"></i></span>
      <h2>Your reading list is empty</h2>
      <p>Open a comic from the gallery and read a few pages. It will show up here so you can pick up where you left off.</p>
      <div class="cr-empty-actions">
        <a class="btn cr-btn-accent" href="/comic">Browse the gallery</a>
      </div>
    </div>
  <% } else { %>
    <ul id="bodyComic" class="cr-grid cr-grid--reading" data-feed="onread" data-offset="<%= rows.length %>" data-page-size="12" data-keyword="<%= keyword %>" aria-label="Reading list">
      <% entries.forEach(function (d, i) { var comic = d.comic; var p = progressOf(d); %>
        <li data-id="<%= comic.id %>">
          <a class="cr-comic-card cr-reading-card" href="/comic/show/<%= encodeURIComponent(comic.id) %>">
            <div class="cr-cover">
              <img src="/comic/cover/<%= encodeURIComponent(comic.id) %><% if (comic.coverImage) { %>?v=<%= encodeURIComponent(comic.coverImage) %><% } %>" alt="" width="400" height="600" decoding="async"<% if (i >= EAGER_COUNT) { %> loading="lazy"<% } else if (i === 0) { %> fetchpriority="high"<% } %>><% if (comic.isPrivate) { %><span class="cr-private-badge" title="Private: only you can see it"><i class="fas fa-lock" aria-hidden="true"></i><span class="visually-hidden">Private</span></span><% } %>
            </div>
            <div class="cr-comic-meta">
              <h2 class="cr-comic-title"><%= comic.title %></h2>
              <% if (comic.author) { %><p class="cr-comic-author"><%= comic.author %></p><% } %>
              <div class="cr-reading-progress">
                <% if (p.total > 0) { %>
                  <div class="cr-progress<%= p.done ? ' is-done' : '' %>" role="progressbar" aria-label="Reading progress" aria-valuemin="0" aria-valuemax="<%= p.total %>" aria-valuenow="<%= p.current %>" aria-valuetext="Page <%= p.current %> of <%= p.total %>">
                    <span style="width: <%= p.percent %>%"></span>
                  </div>
                <% } %>
                <div class="cr-reading-foot">
                  <% if (p.total > 0) { %>
                    <span class="cr-progress-label" aria-hidden="true">p. <%= p.current %>/<%= p.total %> <span class="cr-progress-pct">&middot; <%= p.percent %>%</span></span>
                  <% } else { %>
                    <span class="cr-progress-label">p. <%= p.current %></span>
                  <% } %>
                  <span class="cr-continue" aria-hidden="true"><%= p.done ? 'Read again' : 'Continue' %> <i class="fas fa-play"></i></span>
                </div>
              </div>
            </div>
          </a>
        </li>
      <% }) %>
    </ul>

    <div class="cr-feed-footer">
      <div id="feedStatus" role="status" aria-live="polite"></div>
      <button id="loadMore" type="button" class="btn cr-btn-ghost"<% if (rows.length < 12) { %> hidden<% } %>>Load more</button>
    </div>
    <div id="feedSentinel" class="cr-sentinel" aria-hidden="true"></div>
    <script src="/public/script/loadMoreComic.js?v=5" defer></script>
  <% } %>
</div>
<%- include("footer") %>
