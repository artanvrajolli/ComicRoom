<%- include("header") %>
<%
    var sourceLabels = {
        settings: 'Saved in admin settings',
        environment: 'From environment variable',
        none: 'Not configured'
    };
    var sourceLabel = sourceLabels[settings.source] || sourceLabels.none;
    var providerNames = { commandcode: 'Command Code', openai: 'OpenAI', anthropic: 'Anthropic' };
    var hasKey = !!settings.apiKey;
    var flashText = (typeof msg != 'undefined' && msg) ? String(msg) : '';
    var flashIsSuccess = /saved/i.test(flashText);
%>
<style>
:where(.cr-card) {
    background: var(--cr-surface, #1c1c1f);
    border: 1px solid var(--cr-border, #2e2e33);
    border-radius: var(--cr-radius, 14px);
    box-shadow: var(--cr-shadow, 0 8px 24px rgba(0, 0, 0, .35));
    padding: 1.5rem;
}
:where(.cr-page-title) { font-weight: 700; letter-spacing: -.01em; }
/* Bootstrap display utilities use !important; keep the hidden attribute authoritative */
.ad-page [hidden] { display: none !important; }

.ad-page { max-width: 920px; text-align: left; color: var(--cr-text, #f2f2f3); font-family: var(--cr-font, inherit); }
.ad-muted { color: var(--cr-muted, #a3a3ad); }
.ad-page .fw-semibold { font-weight: 600; }
.ad-section-title { font-size: 1.1rem; font-weight: 700; margin-bottom: .25rem; }

.ad-page .form-label { color: var(--cr-text, #f2f2f3); font-weight: 600; font-size: .9rem; margin-bottom: .35rem; }
.ad-page .form-control, .ad-page .form-select {
    background-color: var(--cr-surface-2, #242428);
    border: 1px solid var(--cr-border, #3a3a40);
    color: var(--cr-text, #f2f2f3);
    border-radius: var(--cr-radius-sm, 8px);
}
.ad-page .form-select { background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23c8c8d0' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e"); }
.ad-page .form-select option { background: var(--cr-surface-2, #242428); color: var(--cr-text, #f2f2f3); }
.ad-page .form-control::placeholder { color: var(--cr-muted, #8b8b95); opacity: 1; }
.ad-page .form-control:focus, .ad-page .form-select:focus {
    background-color: var(--cr-surface-2, #242428);
    color: var(--cr-text, #f2f2f3);
    border-color: var(--cr-accent, #f0a530);
    box-shadow: 0 0 0 .2rem color-mix(in srgb, var(--cr-accent, #f0a530) 30%, transparent);
}
.ad-page .form-control:disabled { opacity: .55; }
.ad-page .form-text { color: var(--cr-muted, #a3a3ad); }
.ad-page .input-group .btn { border-color: var(--cr-border, #3a3a40); }
.ad-page .form-check-input:checked { background-color: var(--cr-danger, #e5534b); border-color: var(--cr-danger, #e5534b); }
.ad-page .form-check-input:focus-visible { outline: 3px solid var(--cr-accent, #f0a530); outline-offset: 2px; }

.ad-page .btn-accent {
    background: var(--cr-accent, #f0a530);
    border-color: var(--cr-accent, #f0a530);
    color: var(--cr-accent-contrast, #1a1205);
    font-weight: 600;
}
.ad-page .btn-accent:hover:not(:disabled) { filter: brightness(1.08); color: var(--cr-accent-contrast, #1a1205); }
.ad-page .btn:focus-visible, .ad-page a:focus-visible { outline: 3px solid var(--cr-accent, #f0a530); outline-offset: 2px; box-shadow: none; }

.ad-status { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: .75rem; margin: 0; }
.ad-status > div { background: var(--cr-surface-2, #242428); border: 1px solid var(--cr-border, #2e2e33); border-radius: var(--cr-radius-sm, 8px); padding: .75rem .9rem; min-width: 0; }
.ad-status dt { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; color: var(--cr-muted, #a3a3ad); }
.ad-status dd { margin: .2rem 0 0; font-weight: 600; overflow-wrap: anywhere; }
.ad-page code { color: var(--cr-text, #f2f2f3); overflow-wrap: anywhere; }
.ad-status code { color: var(--cr-text, #f2f2f3); font-size: .9em; }

.ad-pill { display: inline-flex; align-items: center; gap: .4rem; padding: .25rem .7rem; border-radius: 999px; font-size: .8rem; font-weight: 600; }
.ad-pill.is-ok { background: color-mix(in srgb, var(--cr-success, #3fb950) 18%, transparent); color: var(--cr-success, #3fb950); }
.ad-pill.is-off { background: color-mix(in srgb, var(--cr-danger, #e5534b) 18%, transparent); color: var(--cr-danger, #e5534b); }

.ad-result { border-radius: var(--cr-radius-sm, 8px); padding: .6rem .8rem; font-size: .9rem; border: 1px solid var(--cr-border, #3a3a40); background: var(--cr-surface-2, #242428); }
.ad-result.is-ok { border-color: var(--cr-success, #3fb950); }
.ad-result.is-error { border-color: var(--cr-danger, #e5534b); }

.ad-defaults { width: 100%; font-size: .875rem; }
.ad-defaults th, .ad-defaults td { padding: .4rem .5rem; border-bottom: 1px solid var(--cr-border, #2e2e33); vertical-align: top; }
.ad-defaults th { color: var(--cr-muted, #a3a3ad); font-weight: 600; }
.ad-defaults code { color: var(--cr-text, #f2f2f3); word-break: break-all; }
</style>

<main class="container content_c mt-4 mb-5 ad-page">
    <h1 class="cr-page-title h3 mb-1">Admin</h1>
    <p class="ad-muted mb-4">Configure the AI provider used to fill in comic titles, authors and descriptions from the first pages.</p>

    <% if (flashText) { %>
    <div class="alert <%= flashIsSuccess ? 'alert-success' : 'alert-danger' %> d-flex gap-2 align-items-start" role="<%= flashIsSuccess ? 'status' : 'alert' %>">
        <i class="fas <%= flashIsSuccess ? 'fa-check-circle' : 'fa-exclamation-circle' %> mt-1" aria-hidden="true"></i>
        <div><%= flashText %></div>
    </div>
    <% } %>

    <!-- Current configuration -->
    <section class="cr-card mb-4" aria-labelledby="statusHeading">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 id="statusHeading" class="ad-section-title mb-0">Current configuration</h2>
            <span class="ad-pill <%= hasKey ? 'is-ok' : 'is-off' %>">
                <i class="fas <%= hasKey ? 'fa-check-circle' : 'fa-times-circle' %>" aria-hidden="true"></i>
                <%= hasKey ? 'Configured' : 'Not configured' %>
            </span>
        </div>
        <dl class="ad-status">
            <div><dt>Provider</dt><dd><%= providerNames[settings.provider] || settings.provider %></dd></div>
            <div><dt>Model</dt><dd><code><%= settings.model %></code></dd></div>
            <div><dt>API key</dt><dd><code><%= maskedKey || 'not set' %></code></dd></div>
            <div><dt>Key source</dt><dd><%= sourceLabel %></dd></div>
        </dl>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <button class="btn btn-outline-light btn-sm" id="testAiButton" type="button" aria-describedby="testAiHelp">
                <i class="fas fa-plug" aria-hidden="true"></i> <span>Test connection</span>
            </button>
            <span id="testAiHelp" class="form-text m-0">Uses the saved settings. Save your changes first.</span>
        </div>
        <div id="testAiResult" class="mt-2" role="status" aria-live="polite"></div>
    </section>

    <!-- Settings form -->
    <section class="cr-card mb-4" aria-labelledby="settingsHeading">
        <h2 id="settingsHeading" class="ad-section-title">AI provider settings</h2>
        <p class="form-text mt-0 mb-3">Changes apply to new uploads and to the AI fill button on the edit page.</p>

        <form method="post" action="/admin" id="aiSettingsForm" data-saved-provider="<%= settings.provider %>">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label" for="aiProvider">Provider</label>
                    <select class="form-select" id="aiProvider" name="provider" data-defaults="<%= JSON.stringify(providerDefaults) %>" aria-describedby="providerHelp">
                        <option value="commandcode" <%= settings.provider === 'commandcode' ? 'selected' : '' %>>Command Code</option>
                        <option value="openai" <%= settings.provider === 'openai' ? 'selected' : '' %>>OpenAI</option>
                        <option value="anthropic" <%= settings.provider === 'anthropic' ? 'selected' : '' %>>Anthropic</option>
                    </select>
                    <div id="providerHelp" class="form-text">Changing the provider fills in its default model and endpoint.</div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="aiModel">Model</label>
                    <input class="form-control" id="aiModel" type="text" name="model" value="<%= settings.model %>" autocomplete="off" spellcheck="false">
                </div>

                <div class="col-12">
                    <label class="form-label" for="aiApiKey">API key</label>
                    <div class="input-group">
                        <input class="form-control" id="aiApiKey" type="password" name="apiKey" autocomplete="new-password" spellcheck="false"
                               placeholder="<%= hasKey ? 'Leave blank to keep the current key' : 'Paste the provider API key' %>"
                               aria-describedby="apiKeyHelp providerSwitchWarning">
                        <button class="btn btn-outline-light" type="button" id="toggleKeyButton" aria-controls="aiApiKey" aria-pressed="false">
                            <i class="fas fa-eye" aria-hidden="true"></i><span class="visually-hidden">Show the key you are typing</span>
                        </button>
                    </div>
                    <div id="apiKeyHelp" class="form-text">
                        Current key: <code><%= maskedKey || 'not set' %></code>. Keys are stored on the server and never shown in full. The eye button only reveals what you type here.
                    </div>
                    <div id="providerSwitchWarning" class="form-text text-warning" hidden>
                        <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> You changed the provider. Enter that provider's API key. The saved key belongs to the previous provider and is not kept when you switch.
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label" for="aiBaseUrl">Endpoint URL</label>
                    <input class="form-control" id="aiBaseUrl" type="text" inputmode="url" name="baseUrl" value="<%= settings.baseUrl %>" autocomplete="off" spellcheck="false" aria-describedby="baseUrlHelp">
                    <div id="baseUrlHelp" class="form-text">Full chat completions endpoint (Command Code / OpenAI) or messages endpoint (Anthropic).</div>
                </div>

                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" id="clearKey" type="checkbox" name="clearKey" value="1" aria-describedby="clearKeyHelp">
                        <label class="form-check-label" for="clearKey">Remove saved API key</label>
                    </div>
                    <div id="clearKeyHelp" class="form-text">The environment variable key, if set, will be used instead.</div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button class="btn btn-accent px-4" type="submit" id="saveSettingsButton">
                    <i class="fas fa-save" aria-hidden="true"></i> <span>Save settings</span>
                </button>
            </div>
        </form>
    </section>

    <!-- Reference -->
    <section class="cr-card" aria-labelledby="defaultsHeading">
        <h2 id="defaultsHeading" class="ad-section-title mb-3">Provider defaults</h2>
        <div class="table-responsive">
            <table class="ad-defaults">
                <thead><tr><th scope="col">Provider</th><th scope="col">Default model</th><th scope="col">Endpoint</th></tr></thead>
                <tbody>
                    <tr><th scope="row">Command Code</th><td><code><%= providerDefaults.commandcode.model %></code></td><td><code><%= providerDefaults.commandcode.baseUrl %></code></td></tr>
                    <tr><th scope="row">OpenAI</th><td><code><%= providerDefaults.openai.model %></code></td><td><code><%= providerDefaults.openai.baseUrl %></code></td></tr>
                    <tr><th scope="row">Anthropic</th><td><code><%= providerDefaults.anthropic.model %></code></td><td><code><%= providerDefaults.anthropic.baseUrl %></code></td></tr>
                </tbody>
            </table>
        </div>
        <p class="small ad-muted mt-3 mb-0"><i class="fas fa-shield-alt" aria-hidden="true"></i> Saved credentials are stored outside the repository with restricted file permissions. Environment variables are used when no saved key exists.</p>
    </section>
</main>

<script>
    (function () {
        var testButton = document.getElementById('testAiButton');
        var testResult = document.getElementById('testAiResult');
        var providerSelect = document.getElementById('aiProvider');
        var modelInput = document.getElementById('aiModel');
        var baseUrlInput = document.getElementById('aiBaseUrl');
        var apiKeyInput = document.getElementById('aiApiKey');
        var toggleKeyButton = document.getElementById('toggleKeyButton');
        var clearKey = document.getElementById('clearKey');
        var form = document.getElementById('aiSettingsForm');
        var saveButton = document.getElementById('saveSettingsButton');
        var switchWarning = document.getElementById('providerSwitchWarning');
        var savedProvider = form ? form.getAttribute('data-saved-provider') : '';

        function updateSwitchWarning() {
            if (!switchWarning || !providerSelect || !apiKeyInput) return;
            var switched = providerSelect.value !== savedProvider;
            switchWarning.hidden = !(switched && apiKeyInput.value.trim() === '' && !(clearKey && clearKey.checked));
        }

        if (providerSelect && modelInput && baseUrlInput) {
            providerSelect.addEventListener('change', function () {
                var defaults = {};
                try {
                    defaults = JSON.parse(providerSelect.getAttribute('data-defaults') || '{}');
                } catch (e) {
                    defaults = {};
                }
                var selected = defaults[providerSelect.value];
                if (selected) {
                    modelInput.value = selected.model;
                    baseUrlInput.value = selected.baseUrl;
                }
                updateSwitchWarning();
            });
        }

        if (apiKeyInput) apiKeyInput.addEventListener('input', updateSwitchWarning);

        // Show/hide only the value being typed (the saved key is never sent to the page)
        if (toggleKeyButton && apiKeyInput) {
            toggleKeyButton.addEventListener('click', function () {
                var show = apiKeyInput.type === 'password';
                apiKeyInput.type = show ? 'text' : 'password';
                toggleKeyButton.setAttribute('aria-pressed', show ? 'true' : 'false');
                toggleKeyButton.querySelector('i').className = 'fas ' + (show ? 'fa-eye-slash' : 'fa-eye');
                toggleKeyButton.querySelector('.visually-hidden').textContent = show ? 'Hide the key you are typing' : 'Show the key you are typing';
            });
        }

        // Removing the key makes the key field irrelevant
        if (clearKey && apiKeyInput) {
            clearKey.addEventListener('change', function () {
                apiKeyInput.disabled = clearKey.checked;
                if (toggleKeyButton) toggleKeyButton.disabled = clearKey.checked;
                updateSwitchWarning();
            });
        }

        if (form && saveButton) {
            form.addEventListener('submit', function (event) {
                if (clearKey && clearKey.checked && !window.confirm('Remove the saved API key? AI features will stop working unless an environment key is set.')) {
                    event.preventDefault();
                    return;
                }
                if (apiKeyInput) apiKeyInput.type = 'password';
                setTimeout(function () {
                    saveButton.disabled = true;
                    saveButton.setAttribute('aria-busy', 'true');
                    saveButton.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> <span>Saving...</span>';
                }, 0);
            });
        }

        // Re-enable after back/forward navigation
        window.addEventListener('pageshow', function (event) {
            if (!event.persisted || !saveButton) return;
            saveButton.disabled = false;
            saveButton.removeAttribute('aria-busy');
            saveButton.innerHTML = '<i class="fas fa-save" aria-hidden="true"></i> <span>Save settings</span>';
        });

        if (!testButton || !testResult) {
            return;
        }

        function showResult(ok, message) {
            testResult.className = 'mt-2 ad-result ' + (ok ? 'is-ok' : 'is-error');
            testResult.textContent = '';
            var icon = document.createElement('i');
            icon.className = 'fas me-2 ' + (ok ? 'fa-check-circle text-success' : 'fa-exclamation-circle text-danger');
            icon.setAttribute('aria-hidden', 'true');
            testResult.appendChild(icon);
            testResult.appendChild(document.createTextNode(message));
        }

        testButton.addEventListener('click', function () {
            var label = testButton.querySelector('span');
            testButton.disabled = true;
            testButton.setAttribute('aria-busy', 'true');
            label.textContent = 'Testing...';
            testResult.className = 'mt-2 form-text text-info';
            testResult.textContent = 'Testing the saved connection...';
            fetch('/admin/test', { method: 'POST', headers: { 'Accept': 'application/json' } })
                .then(function (response) {
                    return response.json().catch(function () {
                        return { ok: false, message: 'The server sent an unexpected response (HTTP ' + response.status + ').' };
                    });
                })
                .then(function (data) {
                    showResult(!!data.ok, data.message || (data.ok ? 'Connection works.' : 'The connection test failed.'));
                })
                .catch(function () {
                    showResult(false, 'The connection test failed. Check your network and try again.');
                })
                .finally(function () {
                    testButton.disabled = false;
                    testButton.removeAttribute('aria-busy');
                    label.textContent = 'Test connection';
                });
        });
    })();
</script>
<%- include("footer") %>
