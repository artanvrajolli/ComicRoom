{
    "id": "/",
    "name": "ComicRoom",
    "short_name": "ComicRoom",
    "description": "Read your comic library online or offline.",
    "start_url": "/comic",
    "scope": "/",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#111111",
    "theme_color": "#111111",
    "categories": [
        "books",
        "entertainment"
    ],
    "icons": [
        {
            "src": "/public/icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/public/icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/public/icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Upload a comic",
            "short_name": "Upload",
            "description": "Upload a CBZ, CBR, ZIP, RAR or PDF file",
            "url": "/comic/upload",
            "icons": [
                {
                    "src": "/public/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Continue reading",
            "short_name": "Reading",
            "description": "Comics you have started",
            "url": "/onread",
            "icons": [
                {
                    "src": "/public/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "My uploads",
            "short_name": "Uploads",
            "description": "Status of your upload jobs",
            "url": "/comic/uploads",
            "icons": [
                {
                    "src": "/public/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ],
    "share_target": {
        "action": "/comic/share-target",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "comic",
                    "accept": [
                        ".cbz",
                        ".cbr",
                        ".zip",
                        ".rar",
                        ".pdf",
                        "application/vnd.comicbook+zip",
                        "application/vnd.comicbook-rar",
                        "application/x-cbz",
                        "application/x-cbr",
                        "application/zip",
                        "application/x-zip-compressed",
                        "application/x-rar",
                        "application/x-rar-compressed",
                        "application/vnd.rar",
                        "application/pdf"
                    ]
                }
            ]
        }
    }
}
